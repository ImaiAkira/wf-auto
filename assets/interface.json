        // ===================== 自动刷副本（SpecialEntry）选项 =====================
        // 注意：ProjectInterface 的 pipeline_override 会【整体替换】recognition 对象，
        // 所以这里每个 recognition 都写全 type + param（含 roi），不能只写 expected，
        // 否则会丢掉 type/roi（参考本文件里已有的 gacha/farm 写法）。
        //
        // ============ 批量副本清单（新功能·核心）============
        // 多行文本，每行一条『副本名,难度,次数』：
        //     # 副本名,难度,次数     ← 以 # 开头是注释，空行忽略
        //     猩红巨熊讨伐,中级,3
        //     背鳍三兄弟讨伐,高级,5
        //     宝物域,风,10           ← 迷宫（按「域」选：`域,元素,次数`；元素可写 `-` = 不限）
        //     （域 = 崩坏域/宝物域/幽玄域；元素 = 火/水/雷/风/光/暗；迷宫无难度档）
        //     战阵之宴,-,5           ← 战阵之宴（不做导航，难度位填 -）
        //     幻想连战,-,2           ← 幻想一「套」= 15 关，填 2 = 刷 2 套
        // agent 侧解析（支持中英文逗号/全角半角/前后空格；非法行会明确报错并终止）。
        // 清单非空 → 按清单顺序逐个刷（领主战/降临讨伐/迷宫/战阵之宴/幻想连战）；
        // 清单留空 → 退回下面「打哪个副本」的单目标逻辑。
        // 全局选项（单人/多人、招募要求、自动续战、尝试开启所有前置）对批量同样生效。
        "要刷的副本清单": {
            "type": "input",
            "inputs": [
                {
                    "name": "清单",
                    "label": "要刷的副本清单",
                    "default": "",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "SpecialBatchPlan": {
                    "recognition": {
                        "type": "Custom",
                        "param": {
                            "custom_recognition": "special_batch_plan",
                            "custom_recognition_param": { "list": "{清单}" }
                        }
                    }
                }
            }
        },
