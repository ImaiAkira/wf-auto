            ]
        },
        "是否自动续战": {
            // ★#56 二批（ruling ③）★：运维「现在自动续战的功能我不太想打开」→ **默认关**；
            //   且「否」= **根本不碰**自动续战（把节点关掉），绝不打开功能、绝不误弹
            //   「自动续战功能」确认框（真机实测：开它会弹框并 dead-end）。「是」保留旧行为
            //   （用户显式选择开启时才用）。
            "type": "select",
            "default_case": "否",
            "cases": [
                { "name": "是", "pipeline_override": { "SpecialAutoContinueSet": { "action": { "type": "Click", "param": { "target": [640, 158] } } } } },
                { "name": "否", "pipeline_override": { "SpecialAutoContinueSet": { "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"] } } } } }
            ]
        },
        // ========================= 五重决战（#56）选项 =========================
        // ★跨模式硬规则★：「除了五重决战可以选择自动或手动以外，其他所有战斗都需要勾选自动」。
        //   → 「是否手操」只挂在「五重决战」任务上（守卫 wuchong-cross-mode-auto 把守）。
        // 手操节奏参数 = 运维点名的四个频率参数（点击/弹板/技能频率），全部落在
        //   WuchongBattle 的 custom_action_param；默认值 = scene.wuchong.BATTLE_PARAMS。
        //   ★#71★：已删「手操连点时长」（固定时长截断）—— 手操持续到结算/失败才交还。
        "是否手操": {
            "type": "select",
            "default_case": "自动",
            "cases": [
                {
                    // 自动（默认）：编队页/房间页把「自动」**开**（定位后读状态，关着才点）；
                    // 「自动续战」保持**关**（ruling ③：功能不要打开）；手操引擎节点关掉。
                    // ★战斗内不再切自动★（二批：自动的切换移到战斗外）。
                    // ★本票 #71★：手操时**只在战斗页**关自动（编队页关不住 —— 游戏会在战斗里又打开）；
                    //   非手操时战斗页不做任何自动切换。
                    "name": "自动",
                    "pipeline_override": {
                        "WuchongTeamAutoSet": { "recognition": { "type": "Custom", "param": { "custom_recognition": "auto_switch_state", "custom_recognition_param": { "label": "自动", "state": "off", "ocr_entry": "OcrTask" } } }, "action": { "type": "Custom", "param": { "custom_action": "wuchong_switch", "custom_action_param": { "which": "auto", "on": true, "scene": "wuchong", "on_unknown": "click" } } } },
                        "WuchongTeamContSet": { "recognition": { "type": "Custom", "param": { "custom_recognition": "auto_switch_state", "custom_recognition_param": { "label": "自动续战", "state": "on", "ocr_entry": "OcrTask" } } }, "action": { "type": "Custom", "param": { "custom_action": "wuchong_switch", "custom_action_param": { "which": "cont", "on": false, "scene": "wuchong", "on_unknown": "click" } } } },
                        "WuchongBattle": { "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"] } } },
                        // 与 WuchongBattle 同一形态，raw 默认即关，这里显式兜底：非手操时战斗页不关自动。
                        "WuchongBattleAutoOff": { "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"] } } }
                    }
                },
                {
                    // 手操：编队页/房间页把「自动」**关**（识别 state=on → 只在开着时去关）；
                    // 「自动续战」保持关；手操引擎启用（默认）。★战斗内不再切自动★。
                    // ★本票 #71★：手操时**只在战斗页**关自动（编队页关不住 —— 游戏会在战斗里又打开）；
                    //   非手操时战斗页不做任何自动切换。
                    // ★coop-fix2 P0★：显式**开启** WuchongBattle（raw 默认 __NONE__）并把动作
                    //   manual=true —— 手动确定性来自选项，不依赖会话里「自动开关真的被点下去」；
                    //   手操引擎关的其它情况（自动/raw）下本节点始终 __NONE__，绝不空框空转。
                    // ★要「取消手打、开自动」就切回上面的「自动」★。
                    "name": "手操",
                    "pipeline_override": {
                        "WuchongTeamAutoSet": { "recognition": { "type": "Custom", "param": { "custom_recognition": "auto_switch_state", "custom_recognition_param": { "label": "自动", "state": "on", "ocr_entry": "OcrTask" } } }, "action": { "type": "Custom", "param": { "custom_action": "wuchong_switch", "custom_action_param": { "which": "auto", "on": false, "scene": "wuchong", "on_unknown": "click" } } } },
                        "WuchongBattle": { "recognition": { "type": "Custom", "param": { "custom_recognition": "wuchong_state", "custom_recognition_param": { "state": "wuchong_battle", "ocr_entry": "OcrTask" } } }, "action": { "type": "Custom", "param": { "custom_action": "wuchong_battle", "custom_action_param": { "manual": true } } } },
                        // ★本票 #71★：战斗页关自动节点在此**开启** —— 只在战斗页读到「自动=开」时才命中
                        //   → 才去关（state=on 门控天然避免死循环）。★只关不开★（on=false）、
                        //   ★判不出就不动★（on_unknown=""）。编队页关不住，必须战斗页关。
                        "WuchongBattleAutoOff": { "recognition": { "type": "Custom", "param": { "custom_recognition": "auto_switch_state", "custom_recognition_param": { "label": "自动", "state": "on", "scope": "battle", "ocr_entry": "OcrTask" } } }, "action": { "type": "Custom", "param": { "custom_action": "wuchong_switch", "custom_action_param": { "which": "auto", "on": false, "scene": "wuchong", "scope": "battle", "on_unknown": "" } } } }
                    }
                }
            ]
        },
        "游戏模式": {
            "type": "select",
            "default_case": "多人游戏",
            "cases": [
                {
                    // ★coop-fix2 P0★：单人 = 关掉多人卡；多人专用的共斗房节点（房间挑战 / stale 编队页出口）
                    //   一律保持关（raw 默认即关，这里显式钉死，防上游误开）。
                    "name": "单人游戏",
                    "pipeline_override": {
                        "WuchongModeMulti": { "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"] } } },
                        "WuchongCoopChallenge": { "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"] } } },
                        "WuchongStaleTeam": { "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"] } } },
                        // ★#83★ 单人模式的房间出口：单人链路里出现共斗房 = 上一轮遗留 → 点【返回】离开。
                        //   （raw 默认关，只在这里打开；多人下房间是合法的，绝不自己退。）
                        "WuchongRoomLeave": { "recognition": { "type": "Custom", "param": { "custom_recognition": "wuchong_state", "custom_recognition_param": { "state": "wuchong_room", "ocr_entry": "OcrTask" } } } }
                    }
                },
                {
                    // ★coop-fix2 P0★：多人 ≠ 只关单人卡。真机 07:45 leg_b（`--mode 多人`）复盘：入口
                    //   枢纽从**上一轮单人留下的编队页**直接点了「挑战」→ 又打一局单人；`WuchongModeSolo`
                    //   确实被关掉了，但**根本没走到模式页**，所以关它没用。多人还须：
                    //   · WuchongTeamChallenge（编队页→挑战）改为**本轮进过共斗房**（room_seen=true）才允许
                    //     —— 挡住「先战斗后房间」；
                    //   · 打开 WuchongCoopChallenge（共斗房的「挑战」，raw 默认关）—— 多人真正的开战点；
                    //   · 打开 WuchongStaleTeam（stale 单人编队页 → 返回重选，raw 默认关）。
                    //   于是「多人」在**有效流水线**上不可能「先战斗后房间」；房间必经。
                    "name": "多人游戏",
                    "pipeline_override": {
