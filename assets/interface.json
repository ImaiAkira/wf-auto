                { "name": "对关注者公开", "pipeline_override": { "SpecialRecruitRandom": { "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"] } } }, "SpecialRecruitMutual": { "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"] } } } } },
                { "name": "对互相关注者公开", "pipeline_override": { "SpecialRecruitRandom": { "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"] } } }, "SpecialRecruitFans": { "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"] } } } } },
