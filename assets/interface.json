                // 单人：关掉多人模式节点；关掉「房间页战斗」节点（它的 ROI 在屏幕最下方，
                // 实测会误命中详情页最低档行内的「战斗」→ 造成错误开打/计数）；
                // 并启用「误入多人房间页」兜底（识别 Party+复制 → 点返回退出后重试）。
                { "name": "单人", "pipeline_override": { "SpecialModeMulti": { "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"] } } }, "SpecialRoomFight": { "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"], "roi": [0, 1050, 720, 180] } } }, "SpecialLeaveRoom": { "recognition": { "type": "And", "param": { "all_of": ["SpecialPartyText", "SpecialRoomCopyText", "SpecialRoomPowerText"], "box_index": 0 } } } } },
                // 多人：关掉「单人游戏」节点；关掉编队页「挑战」节点（多人的开打是房间页「战斗」，
                // 避免同一场战斗被 Challenge 与 RoomFight 各记一次 → 次数翻倍）。
                { "name": "多人", "pipeline_override": { "SpecialModeSolo": { "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"] } } }, "SpecialChallenge": { "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"], "roi": [180, 1000, 400, 180] } } } } }
            ]
        },
