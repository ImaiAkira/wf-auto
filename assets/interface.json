                        "WuchongTeamChallenge": { "recognition": { "type": "And", "param": { "all_of": [
                            { "recognition": { "type": "Custom", "param": { "custom_recognition": "wuchong_state", "custom_recognition_param": { "state": "wuchong_team", "room_seen": true, "ocr_entry": "OcrTask" } } } },
                            "WuchongChallengeText"
                        ], "box_index": 1 } } },
                        "WuchongCoopChallenge": { "recognition": { "type": "Custom", "param": { "custom_recognition": "wuchong_state", "custom_recognition_param": { "state": "wuchong_room", "recruit_state": "started", "ocr_entry": "OcrTask" } } } },
                        "WuchongStaleTeam": { "recognition": { "type": "Custom", "param": { "custom_recognition": "wuchong_state", "custom_recognition_param": { "state": "wuchong_team", "room_seen": false, "ocr_entry": "OcrTask" } } } },
                        // ★#83★ 多人下房间是合法的（要招募/等人），房间出口保持关。
                        "WuchongRoomLeave": { "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"] } } }
                    }
                }
            ]
        },
        // 领主加成点数弹窗（详情页→战斗后的必经确认框）：答「否/是」= 关掉另一个节点。
        "使用领主加成点数": {
            "type": "select",
            "default_case": "否",
            "cases": [
                { "name": "否", "pipeline_override": { "WuchongBonusYes": { "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"] } } } } },
                { "name": "是", "pipeline_override": { "WuchongBonusNo": { "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"] } } } } }
            ]
        },
        // ★手操节奏参数（运维：「点击频率、弹板频率、放技能频率都要能通过参数控制、写在参数面板上」）★
        //   四个字段全部落到 WuchongBattle.custom_action_param；字段名 = 运维点名的词。
        //   ★#71★：`手操连点时长` 已删除 —— 手操持续到结算/失败，不存在固定时长截断
        //     （引擎持续点板/放技能直到【结算】或【关卡失败】才交还）。
        "手操节奏参数": {
            "type": "input",
            "inputs": [
                { "name": "弹板间隔", "label": "弹板间隔（毫秒）", "default": "220", "pipeline_type": "int", "verify": "^[1-9][0-9]*$", "pattern_msg": "请输入正整数毫秒（≥20）" },
                { "name": "技能间隔", "label": "技能间隔（毫秒）", "default": "800", "pipeline_type": "int", "verify": "^[0-9]+$", "pattern_msg": "请输入非负整数毫秒" },
                { "name": "每几次弹板放技能", "label": "每几次弹板放技能", "default": "6", "pipeline_type": "int", "verify": "^[0-9]+$", "pattern_msg": "0=不放技能；否则正整数" },
                { "name": "连点批量", "label": "连点批量（次）", "default": "10", "pipeline_type": "int", "verify": "^[1-9][0-9]*$", "pattern_msg": "请输入正整数（≥1）" }
            ],
            "pipeline_override": {
                "WuchongBattle": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "wuchong_battle",
                            "custom_action_param": {
                                // ★真机 P0（本票）：手操确定性必须落在这里★
                                // MFAAvalonia 把每个选项的 pipeline_override **分别**交给
                                // MaaFramework（真机 maafw.log 的 post_task：pipeline_override 是一个
                                // **列表**）；MaaFramework 对同一节点的 action.param **整体替换**
                                // （实测：最终 custom_action_param 只剩节奏 5 字段，`manual` 被丢）。
                                // 本选项（手操节奏参数）在任务 option 列表里排最后 → 它是 WuchongBattle
                                // 动作的**最终写者**。因此 `manual: true` 必须写在这里，「是否手操=手操」
                                // 里那份会被本覆盖盖掉（那边保留作 defense-in-depth / 无本选项时用）。
                                // 结点本身只在「是否手操=手操」时被识别启用（自动/raw = __NONE__），
                                // 故这里 manual:true 对「自动」是**休眠**的，绝不误开手操。
                                "manual": true,
                                "flipper_gap_ms": "{弹板间隔}",
                                "skill_gap_ms": "{技能间隔}",
                                "skill_every": "{每几次弹板放技能}",
                                "burst": "{连点批量}"
                            }
                        }
                    }
                }
            }
        },
        // ★「五重打几次」（本票）★：五重决战「需要打的次数」——打够 N 次就优雅收工。
        //   引擎侧（agent/wuchong_impl）用**既有账本 + 既有收工机制**落实，绝不另造一套：
        //     · 每进入一次【结算页】（wuchong_settle）记一笔账本 `wuchong/fight/{n}`（跨重开恢复）；
        //     · WuchongGiveUp（既有兜底出口 = StopTask + 写 wuchong/run/completed）读 target_fights，
        //       已打够 N 次即按同一理由收工；新任务见收工标记即清账（与深渊/幻想同口径）。
        //   0（默认留空同义）视为**不限制** = 保持旧行为（一直刷到异常兜底）；默认 1 = 打一次。
        //   ★override 必须写全 recognition（ProjectInterface 的 override 会整体替换 recognition 对象）★。
        //   ★键名带「五重」前缀（真机外修复）★：option 是**全局命名空间**（按名索引）；裸「打几次」
        //   会与「自动刷副本」任务既有的同名选项**撞键**，同名 JSON 键后者覆盖前者 →
        //   「自动刷副本」的「打几次」（写 SpecialFightTargetRow.max_hit）静默失效。
        //   GUI 可见的 input label 仍是「打几次」；只有键名加前缀以避撞。
        "五重打几次": {
            "type": "input",
            "inputs": [
                {
                    "name": "次数",
                    "label": "打几次",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[0-9]+$",
                    "pattern_msg": "请输入非负整数（打够 N 次就收工；0 = 不限制）"
                }
            ],
            "pipeline_override": {
                "WuchongGiveUp": {
                    "recognition": {
                        "type": "Custom",
                        "param": {
                            "custom_recognition": "wuchong_giveup",
                            "custom_recognition_param": {
                                "ocr_entry": "OcrTask",
                                "max_task_sec": 0,
                                "lost_sec": 60,
                                "no_progress_sec": 900,
                                "room_wait_sec": 300,
                                "target_fights": "{次数}"
                            }
                        }
                    }
                }
            }
        },
        // ★「五重续关几次」（#72）★：GAMEOVER 屏点【续关】（不是【放弃】）——失败后最多续关 N 次。
        //   引擎侧（agent/wuchong_impl）用**既有账本 + 既有收工机制**落实，绝不另造一套：
        //     · 每个 GAMEOVER episode 记一笔账本 `wuchong/continue/{n}`（跨重开恢复）；
        //     · WuchongContinueGuard（既有 StopTask 出口 = 写 wuchong/run/completed）读 target_continues，
        //       已续关 N 次后再遇 GAMEOVER 即按同一理由带原因收工（绝不空转）。
        //   0（默认）= **不限制** = 保持「续关无限」（规格 B3）；N>0 时**恰好允许 N 次**续关。
        //   ★override 必须写全 recognition（ProjectInterface 的 override 会整体替换 recognition 对象）★：
        //   整体替换本节点的 recognition，但**只写 WuchongContinueGuard** —— 与「五重打几次」写的
        //   WuchongGiveUp 是**不同节点**，故 MAA 的整体替换不可能互相清掉（两选项可共存）。
        //   ★键名带「五重」前缀（避撞键）★：option 是全局命名空间（按名索引）。
        "五重续关几次": {
            "type": "input",
            "inputs": [
                {
                    "name": "次数",
                    "label": "续关几次",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^[0-9]+$",
                    "pattern_msg": "请输入非负整数（失败后最多续关 N 次；0 = 不限）"
                }
            ],
            "pipeline_override": {
                "WuchongContinueGuard": {
                    "recognition": {
                        "type": "Custom",
                        "param": {
                            "custom_recognition": "wuchong_continue_guard",
                            "custom_recognition_param": {
                                "ocr_entry": "OcrTask",
                                "target_continues": "{次数}"
                            }
                        }
                    }
                }
            }
        },
        "尝试开启所有前置": {
            "type": "select",
            "default_case": "是",
            "cases": [
                { "name": "是", "pipeline_override": {} },
                { "name": "否", "pipeline_override": { "SpecialNewBadge": { "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"], "roi": [0, 380, 120, 600] } } } } }
            ]
        },
        // ===================== 「打到哪一档」= 打满 / 指定难度 =====================
        // ★本选项必须排在任务 option 列表【最后】：它的 override 要盖过
        //   「打哪个难度」（会设 SpecialFightTargetRow.recognition）与
        //   「尝试开启所有前置」（会关 SpecialNewBadge），否则打满模式会被重新拆掉。
        // 全部(打满) 语义：详情页只要还认得出 NEW 行的【战斗】就继续打，
        //   直到认不出 NEW 行 —— SpecialFullNoNew 连续 3 次命中后 SpecialFullStop 收工。
        //   此模式下 SpecialFightTargetRow 关闭，因此「打哪个难度」「打几次」都不生效（按需求忽略）。
        "打到哪一档": {
            "type": "select",
            "default_case": "指定难度",
            "cases": [
                {
                    "name": "指定难度",
                    "pipeline_override": {}
                },
                {
                    "name": "全部(打满)",
                    "pipeline_override": {
                        // 打满模式：关掉「指定难度」节点（difficulty "__NONE__" 永不命中）。
                        "SpecialFightTargetRow": { "recognition": { "type": "Custom", "param": { "custom_recognition": "special_target_fight", "custom_recognition_param": { "difficulty": "__NONE__" } } } },
                        "SpecialNewBadge": { "recognition": { "type": "OCR", "param": { "expected": ["^NEW$"], "roi": [0, 380, 120, 600] } } },
                        // 首发档兜底：点 SpecialBattleBtn（最上面的【战斗】）本身，零偏移。
                        "SpecialFullFirstFight": { "recognition": { "type": "And", "param": { "all_of": ["SpecialDetailGate", "SpecialFirstReward", "SpecialBattleBtn"], "box_index": 2 } } },
                        "SpecialLeaveRoom": { "recognition": { "type": "And", "param": { "all_of": ["SpecialPartyText", "SpecialRoomCopyText", "SpecialRoomPowerText"], "box_index": 0 } } },
                        "SpecialFullNoNew": { "recognition": { "type": "OCR", "param": { "expected": ["推荐编成"] } } },
                        "SpecialFullStop": { "recognition": { "type": "OCR", "param": { "expected": ["推荐编成"] } } }
                    }
                }
            ]
        },
        // ===================== 唤醒/恢复游戏（RecoverEntry）选项 =====================
        // 三个选项同属一组值，被 recover 流程与卡死检测复用：
        //   · 无响应重开阈值 → stall_recover 的 threshold_sec（秒，默认 180）
        //   · 重开后等待     → 点「点击开始」后 / 重开游戏内部的等待秒数（默认 35）
        //   · 登录后等待     → 点「继续游戏」后 / 重开游戏内部的等待秒数（默认 20）
        // 注意：ProjectInterface 的 pipeline_override 会【整体替换】recognition / action 对象，
        // 所以这里每个覆盖都写全 type + param。
        "无响应重开阈值": {
            "type": "input",
            "inputs": [
                {
                    "name": "无响应重开阈值",
                    "label": "无响应重开秒数",
                    "default": "180",
                    "pipeline_type": "int",
                    "verify": "^[1-9][0-9]*$",
                    "pattern_msg": "请输入正整数（秒）"
                }
            ],
            "pipeline_override": {
                "RecoverStallRestart": {
                    "recognition": {
                        "type": "Custom",
                        "param": {
                            "custom_recognition": "stall_recover",
                            "custom_recognition_param": { "threshold_sec": "{无响应重开阈值}" }
                        }
                    }
                },
                // ★同一个阈值也套到外传/特殊副本的分派器卡死兜底上★（需求 #3：
                //   「阈值复用已有的无响应重开阈值，不要新造一套」）。
                "SideStallRecover": {
                    "recognition": {
                        "type": "Custom",
                        "param": {
                            "custom_recognition": "stall_recover",
                            "custom_recognition_param": { "threshold_sec": "{无响应重开阈值}" }
                        }
                    }
                },
                "SpecialStallRecover": {
                    "recognition": {
                        "type": "Custom",
                        "param": {
                            "custom_recognition": "stall_recover",
                            "custom_recognition_param": { "threshold_sec": "{无响应重开阈值}" }
                        }
                    }
                },
                "PushStallRecover": {
                    "recognition": {
                        "type": "Custom",
                        "param": {
                            "custom_recognition": "stall_recover",
                            "custom_recognition_param": { "threshold_sec": "{无响应重开阈值}" }
                        }
                    }
                }
            }
        },
        "重开后等待": {
            "type": "input",
            "inputs": [
                {
                    "name": "重开后等待",
                    "label": "重开后等待秒数",
                    "default": "35",
                    "pipeline_type": "int",
                    "verify": "^[0-9]+$",
                    "pattern_msg": "请输入非负整数（秒）"
                }
            ],
            "pipeline_override": {
                "RecoverWaitStart": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "wait_seconds",
                            "custom_action_param": { "seconds": "{重开后等待}" }
                        }
                    }
                },
                "RecoverRestartGame": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "restart_game",
                            "custom_action_param": {
                                "pkg": "com.leiting.wf",
                                "restart_wait": "{重开后等待}",
                                "login_wait": "{登录后等待}",
                                "start_wait": "{重开后等待}",
                                "force_stop_wait": 3,
                                "nav_wait": 4
                            }
                        }
                    }
                },
                "RecoverStallRestart": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "restart_game",
                            "custom_action_param": {
                                "pkg": "com.leiting.wf",
                                "restart_wait": "{重开后等待}",
                                "login_wait": "{登录后等待}",
                                "start_wait": "{重开后等待}",
                                "force_stop_wait": 3,
                                "nav_wait": 4
                            }
                        }
                    }
                },
                // ★同「重开后等待 / 登录后等待」也套到「自动过主线」的卡死重开上★
                //   （PushStallRecover.action，写法照抄上面的 RecoverStallRestart）。
                "PushStallRecover": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "restart_game",
                            "custom_action_param": {
                                "pkg": "com.leiting.wf",
                                "restart_wait": "{重开后等待}",
                                "login_wait": "{登录后等待}",
                                "start_wait": "{重开后等待}",
                                "force_stop_wait": 3,
                                "nav_wait": 4
                            }
                        }
                    }
                }
            }
        },
        "登录后等待": {
            "type": "input",
            "inputs": [
                {
                    "name": "登录后等待",
                    "label": "登录后等待秒数",
                    "default": "20",
                    "pipeline_type": "int",
                    "verify": "^[0-9]+$",
                    "pattern_msg": "请输入非负整数（秒）"
                }
            ],
            "pipeline_override": {
                "RecoverWaitLogin": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "wait_seconds",
                            "custom_action_param": { "seconds": "{登录后等待}" }
                        }
                    }
                }
            }
        },
        // ===================== 外传关卡账本范围（SideStoryEntry） =====================
        // next_stage 的参数 scope：账本 key = side_story/{scope}/{关卡}。
        // 留空时由 next_stage 自动读取画面顶部的大标题（如「百兽王冠」），
        // 一次性清多个外传时建议留空。填了则固定到该副本。
        "外传账本范围": {
            "type": "input",
            "inputs": [
                {
                    "name": "副本名",
                    "label": "外传副本名",
                    "default": "",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "SideNextSpecial": { "recognition": { "type": "Custom", "param": { "custom_recognition": "next_stage", "custom_recognition_param": { "scene": "side_story", "row_type": "特殊战斗", "require_badge": true, "scope": "{副本名}" } } } },
                "SideNextStory": { "recognition": { "type": "Custom", "param": { "custom_recognition": "next_stage", "custom_recognition_param": { "scene": "side_story", "row_type": "STORY", "require_badge": true, "scope": "{副本名}" } } } },
                "SideNextBattle": { "recognition": { "type": "Custom", "param": { "custom_recognition": "next_stage", "custom_recognition_param": { "scene": "side_story", "row_type": "战斗", "require_badge": true, "scope": "{副本名}" } } } }
            }
        },
        // ===================== 外传是否刷所有的（SideStoryEntry） =====================
        // 是（默认）= 现状：清完「外传故事列表」里所有未通关外传。
        // 否 = 只打当前打开的这个外传，打完回列表即收工：
        //   · 关 SideClearPickTab  → recognition 置 OCR expected ["__NONE__"]（不点「未通关」tab）
        //   · 关 SideClearEnterCard → recognition 置 OCR expected ["__NONE__"]（不点第一张卡）
        //   · SideClearListGate    → action 置 StopTask（回列表即停，绝不空转）
        // ★刻意不关 SideClearDone / SidePageDoneStop★：空列表与防空转的安全网要保留。
        // 注：ProjectInterface 的 pipeline_override 会【整体替换】recognition / action 对象，
        //     所以这里写全 type + param，不能只写 expected。
        "外传是否刷所有的": {
            "type": "select",
            "default_case": "是",
            "cases": [
                {
                    "name": "是",
                    "pipeline_override": {}
                },
                {
                    "name": "否",
                    "pipeline_override": {
                        "SideClearPickTab": { "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"], "roi": [0, 375, 240, 70] } } },
                        "SideClearEnterCard": { "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"] } } },
                        "SideClearListGate": { "action": { "type": "StopTask" } }
                    }
                }
            ]
        },
        // ===================== 自动刷副本·幻想连战（兼容/进阶单目标）=====================
        // 刷几套：一整套 = 15 关。填 N 就重复 N 套后收工。挂在「自动刷副本」上。
        // 值经 pipeline_override 注入 phantom_done / phantom_giveup 的 target_sets；
        // 用批量清单写『幻想连战,-,N』时改由清单驱动，本选项不生效。
        // 注意 ProjectInterface 的 pipeline_override 会【整体替换】recognition 对象，
        // 所以这里写全 type + param（含 ocr_entry），不能只写 target_sets。
        "刷几套": {
            "type": "input",
            "inputs": [
                {
                    "name": "套数",
                    "label": "刷几套",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9][0-9]*$",
                    "pattern_msg": "请输入正整数（≥1）。1 套 = 15 关，填 N 就打 N 套后收工"
                }
            ],
            "pipeline_override": {
                "PhantomDone": {
                    "recognition": {
                        "type": "Custom",
                        "param": {
                            "custom_recognition": "phantom_done",
                            "custom_recognition_param": { "ocr_entry": "OcrTask", "target_sets": "{套数}" }
                        }
                    }
                },
                "PhantomGiveUp": {
                    "recognition": {
                        "type": "Custom",
                        "param": {
                            "custom_recognition": "phantom_giveup",
                            "custom_recognition_param": {
                                "ocr_entry": "OcrTask",
                                "max_task_sec": 7200,
                                "lost_sec": 60,
                                "no_progress_sec": 900,
                                "target_sets": "{套数}"
                            }
                        }
                    }
                }
            }
        },
        // ===================== 自动刷副本·幻想连战·关卡上限 =====================
        // 「打到第几关以后放弃」：0 = 不限制（默认，保持旧行为）；1~15 = 打到第 N 关
        // ★打完才停★（在第 N 关的结算帧收工，绝不留在战斗中途）。理由：结算页是本关
        // 打完后的安全边界，且「打到第 N 关」字面就是要把第 N 关打完。
        //
        // 与「刷几套」+ 批量清单的交互（★三者取先到者，上限到了 = 整个任务优雅收工★）：
        //   · 单一目标：PhantomDone 命中 → 管线 StopTask（并写 phantom/run/completed）；
        //   · 批量清单：PhantomDone 在 batch 模式下令 PhantomDispatch 走 SpecialBatchStop，
        //     回一次指挥官再优雅停止（不写收工标记，保留套数统计）。
        //   为什么是「整任务」而非「该目标」：套数未满时只收「该目标」的话，指挥官会按
        //   remaining>0 立刻重选同一条幻想目标 → 在「已达上限」与「还没刷够」间空转；
        //   且「放弃」本就是整轮语义。
        //
        // 实现：stage_cap 经下面三个 phantom_state 节点（关卡选择页/战斗/结算）注入会话
        // （agent 侧只在这些带 stage_cap 键的节点更新上限；其它 phantom_state 节点不带，
        // 不会把上限抹掉）。判据只看【本次任务会话】实际打到的关号，接管时从画面当前关号
        // 起步 —— 与「中途接管以画面为准」一致，不拿旧账本提前收工。
        // 注意 ProjectInterface 的 pipeline_override 会【整体替换】recognition 对象，
        // 所以这里写全 type + param（含 state / ocr_entry），不能只写 stage_cap。
        "打到第几关以后放弃": {
            "type": "input",
            "inputs": [
                {
                    "name": "关卡",
                    "label": "打到第几关以后放弃（0=不限制）",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^([0-9]|1[0-5])$",
                    "pattern_msg": "请输入 0（不限制）或 1~15（打到第 N 关打完就收工）"
                }
            ],
            "pipeline_override": {
                "PhantomMainFight": {
                    "recognition": {
                        "type": "Custom",
                        "param": {
                            "custom_recognition": "phantom_state",
                            "custom_recognition_param": {
                                "state": "phantom_main",
                                "ocr_entry": "OcrTask",
                                "stage_cap": "{关卡}"
                            }
                        }
                    }
                },
                "PhantomBattleWait": {
                    "recognition": {
                        "type": "Custom",
                        "param": {
                            "custom_recognition": "phantom_state",
                            "custom_recognition_param": {
                                "state": "phantom_battle",
                                "ocr_entry": "OcrTask",
                                "stage_cap": "{关卡}"
                            }
                        }
                    }
                },
                "PhantomSettleState": {
                    "recognition": {
                        "type": "Custom",
                        "param": {
                            "custom_recognition": "phantom_state",
                            "custom_recognition_param": {
                                "state": "phantom_settle",
                                "ocr_entry": "OcrTask",
                                "stage_cap": "{关卡}"
                            }
                        }
                    }
                }
            }
        }
    }
}
