{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "弹射世界国服自动化",
    "description": "《弹射世界》国服（雷霆）日常自动化：主线、外传、副本、扭蛋等一键托管。",
    "contact": "GitHub Issues: https://github.com/ImaiAkira/wf-auto/issues",
    "license": "MIT",
    "welcome": "欢迎使用《弹射世界》国服自动化！首次使用请先完成配置并连接游戏。",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/ImaiAkira/wf-auto",
    // 版本号由 CI 用 tools/fill_interface.py --version <tag> 覆盖（去掉前导 v），本地不要手改
    "version": "1.0.6",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "wf-auto", // 占位：真实 rid 由 Mirror酱 分配，禁止自编
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    // Agent：auto_push 的「已打关卡记录」依赖它
    // （自定义识别 stage_next / stage_all_done，见 agent/my_reco.py）。
    //
    // child_exec 用随包内置的【便携 Python】：install/python/python.exe。
    //   - {PROJECT_DIR} = MFAAvalonia.exe（= interface.json）所在目录，由 MFAAvalonia
    //     的 ReplacePlaceholder 替换；子进程 CWD 也是这个目录。
    //   - 所以整个文件夹可以解压到任意路径，不用改配置。
    //   - 【绝对不要改成 .venv】：venv 的 pyvenv.cfg 与 Scripts/*.exe 里写死了创建时
    //     的 base Python 绝对路径，换机器必崩；便携 Python 才是可搬移的。
    //   - 这个便携 Python 里只装了 agent 真正需要的 maafw==5.13.1
    //     （连带 MaaAgentBinary / numpy / StrEnum）。
    "agent": {
        "child_exec": "{PROJECT_DIR}/python/python.exe",
        "child_args": [
            "-u",
            "{PROJECT_DIR}/agent/main.py",
            // ★#86★ 静音：GUI 面板只显示「要打几次 / 第几次 / 收工原因」，
            //   机制日志（点击/校验/心跳/账本…）写 install/debug/wuchong_agent.log。
            "--quiet"
        ]
    },
    "task": [
        {
            "name": "切换编队",
            "entry": "TeamEntry",
            "description": "把编队切到指定 SET/队。从【主城】或任意页面开始，闭环切换并校验。",
            "option": ["切换编队"]
        },
        {
            "name": "自动刷副本",
            "entry": "SpecialEntry",
            "description": "一次刷领主战/降临讨伐/迷宫/战阵之宴/幻想连战。用「要刷的副本清单」填多行『副本名,难度,次数』批量刷（幻想写『幻想连战,-,2』=2 套）；留空则按单目标选项刷。使用前处于【主城】或副本页面。",
            "option": [
                "要刷的副本清单",
                "打哪个副本",
                "打哪个难度",
                "打几次",
                "单人还是多人",
                "多人招募要求",
                "是否自动续战",
                "尝试开启所有前置",
                // 兼容/进阶：以下 4 个选项原本绑定已删除的「重复刷图 / 战阵之宴自动刷 /
                // 自动刷幻想」。保留定义并挂到本任务作单目标用法（清单非空时以清单为准）。
                "打哪个迷宫域",
                "打哪个迷宫元素",
                "刷几次",
                "使用迷宫加成点数",
                "战阵刷几次",
                "刷几套",
                // 关卡上限：0=不限制（默认，保持旧行为）；1~15=打到第 N 关打完就优雅收工。
                // 放在「打到哪一档」之前即可（不同节点、无覆盖冲突）。
                "打到第几关以后放弃",
                // ★必须最后：见 option「打到哪一档」的注释。
                "打到哪一档"
            ]
        },
        {
            "name": "自动过主线",
            "entry": "AutoPush",
            "option": [
                // PushStallRecover 的卡死阈值（默认 180s）；重开等待同理（默认 35/20）。
                // 与「唤醒/恢复游戏」共用同一组选项，不新造一套。
                "无响应重开阈值",
                "重开后等待",
                "登录后等待"
            ]
        },
        {
            "name": "自动过外传",
            "entry": "SideStoryEntry",
            "description": "会看你在哪自动分流：在外传列表页/主城 → 清未通关外传（由「外传是否刷所有的」控制）；已在外传内 → 只打当前这个。使用前处于【主城】或外传任意页面。",
            "option": [
                "外传账本范围",
                "外传是否刷所有的"
            ]
        },
        {
            "name": "自动刷深渊EX",
            "entry": "AbyssEntry",
            "description": "自动刷深渊连战EX（30 层线性阶梯，★全单人、无共斗★）。从【主城】或深渊EX任意页面出发自行导航：活动 → 终始之战 → 在【已通关/未通关/完成】三个二级页签里搜到「深渊EX」横幅后进入（页签不固定，随账号进度变；幻想连战/深渊/深渊EX 共用这条导航）。一直往下刷（不关心套数）：刷完 30 层游戏跳回关卡选择页就继续。使用前处于【主城】或深渊EX任意页面。"
        },
        {
            // ★普通深渊（#55 Phase 3）★：与「自动刷深渊EX」【共用同一份实现与同一条流水线】
            // （运维：「深渊和深渊EX 只有导航的区别」）；差异只在【横幅模板 + 进关确认文案 +
            // 账本范围】。入口 AbyssPlainEntry 声明活动场景 = abyss_plain（账本 abyss_plain）。
            "name": "自动刷深渊",
            "entry": "AbyssPlainEntry",
            "description": "自动刷普通深渊连战（30 层线性阶梯，★全单人、无共斗★）。与「自动刷深渊EX」共用一条流水线（只差导航）：从【主城】或普通深渊任意页面出发自行导航：活动 → 终始之战 → 在【已通关/未通关/完成】三个二级页签里搜到「深渊连战」横幅后进入（页签不固定，随账号进度变；本账号普通深渊在【完成】页签）。一直往下刷（不关心套数）：刷完 30 层游戏跳回关卡选择页就继续。使用前处于【主城】或普通深渊任意页面。"
        },
        {
            // ★五重决战（#56 Phase 4）★：共斗开房 + ★手操战斗★。
            // 导航：主城 → 领主战 → 降临讨伐 → 滚动找「五王连战」行（模板优先）→
            //   五重决战·超级 详情 → 单人/多人 → 编队/房间 → 招募 → 开始招募 → 人齐 → 挑战。
            // ★只有本任务允许「手操」★：其余所有战斗一律「自动」（跨模式硬规则）。
            "name": "五重决战",
            "entry": "WuchongEntry",
            "description": "自动刷【五重决战】（共斗开房 + 可选手操）。导航：主城 → 领主战 → 降临讨伐 → 滚动找「五王连战」行 → 五重决战·超级 → 单人/多人（默认多人）→ 编队/房间 → 招募 → 开始招募 → 人齐 → 挑战。★手操（默认关闭）时全程点弹板 + 放技能，节奏由「手操节奏参数」控制（★#71：手操持续到结算/失败，无固定时长上限★）；要取消手打、切回自动就选「是否手操=自动」。★除本任务外，其他所有战斗都必须开「自动」★。使用前处于【主城】或五重决战任意页面。",
            "option": [
                "是否手操",
                "游戏模式",
                "使用领主加成点数",
                "手操节奏参数",
                // ★「五重打几次」（本票）★：五重「需要打的次数」——打够 N 次就优雅收工。放在最后
                //   （不冲突：只有它写 WuchongGiveUp 的识别参数）。
                //   ★名字带「五重」前缀★：option 是全局命名空间；裸「打几次」会与「自动刷副本」
                //   的同名选项撞键（同名 JSON 键后者覆盖前者 → 那个功能的 max_hit 静默失效）。
                "五重打几次",
                // ★「五重续关几次」（#72）★：GAMEOVER 屏点【续关】（不是【放弃】）——失败后最多续关 N 次。
                //   ★与上面「五重打几次」写的是**不同节点**（WuchongContinueGuard vs WuchongGiveUp）★：
                //   MAA 的 pipeline_override 是整体替换**某节点**的对象，两个选项因此互不覆盖、可共存。
                "五重续关几次"
            ]
        },
        {
            "name": "扭蛋箱抽取",
            "entry": "PullEntry",
            "description": "在当前已打开的「活动扭蛋箱」页面循环抽取；箱子抽空（剩余×0）会自动「库存重置」。使用前先手动打开扭蛋箱页面。"
        },
        {
            "name": "扭蛋（抽卡）",
            "entry": "GachaEntry",
            "description": "在当前已打开的扭蛋池上抽 N 发十连，抽满即停。★武器池/角色池都行，用十连券或有券不足时花免费星导石都行★（区别只是有没有券，与池子类型无关）。只抽十连，不用「1次抽取」。使用前先把要抽的池子切到中间。抽完停在扭蛋池页，不回主城。",
            "option": [
                "抽几发"
            ]
        },
        {
            "name": "唤醒/恢复游戏",
            "entry": "RecoverEntry",
            "description": "把卡死/掉线/未知页面的游戏拉回【主城】；认不出的页面按实测流程强杀重开，画面连续无变化超阈值也重开。绝不使用返回键。其他任务也会自动调用本流程做兜底。",
            "option": [
                "无响应重开阈值",
                "重开后等待",
                "登录后等待"
            ]
        }
    ],
    "option": {
        "切换编队": {
            // ★#91★ 切换编队（SET / 队）。值域来自真机标定（scene/team.py）：
            //   选哪一队由玩家自己的编队决定（例：练度高的账号常备一套通解队）。
            //   切换是闭环的（读 `SET N` → 点邻居 → 再读），不按固定坐标。
            "type": "select",
            "default_case": "不切换",
            "cases": [
                { "name": "不切换" },
                { "name": "Set1第1队" },
                { "name": "Set1第2队" },
                { "name": "Set1第3队" },
                { "name": "Set1第4队" },
                { "name": "Set1第5队" },
                { "name": "Set1第6队" }
            ]
        },
        "抽几发": {
            // ★#26★ 抽几发十连 = **总数**（含点下去的第一发）。默认 1。
            //   落点 = GachaCount 的 custom_recognition_param.times（计数口径在 agent 侧：
            //   数「汇总页出现」= 这一发真的抽出去了）。
            //   ★不写 max_hit★：它是全任务共享的静默计数器，用光只让节点从 next 消失，
            //   结束不了任务（旧实现因此永远空转，见 docs/guide/max-hit-debt.md）。
            "type": "input",
            "inputs": [
                {
                    "name": "次数",
                    "label": "抽几发",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9][0-9]*$",
                    "pattern_msg": "请输入正整数（1 = 只抽一发）"
                }
            ],
            "pipeline_override": {
                "GachaCount": {
                    "recognition": {
                        "type": "Custom",
                        "param": {
                            "custom_recognition": "gacha_count",
                            "custom_recognition_param": { "times": "{次数}", "ocr_entry": "OcrTask" }
                        }
                    }
                }
            }
        },
        // 战阵刷几次（兼容/进阶）：循环次数，挂在「自动刷副本」上作单目标刷战阵之宴用。
        // 覆盖 RaidContinueChallenge.max_hit。999999 = 一直刷；不要填 0（0 会永远不点「再次挑战」）。
        // 用「要刷的副本清单」批量刷（写『战阵之宴,-,N』）时以清单为准，本选项不生效。
        "战阵刷几次": {
            "type": "input",
            "inputs": [
                {
                    "name": "次数",
                    "label": "循环次数",
                    "default": "999999",
                    "pipeline_type": "int",
                    "verify": "^[1-9][0-9]*$",
                    "pattern_msg": "请输入正整数（≥1；要一直刷填 999999；不要填 0）"
                }
            ],
            "pipeline_override": {
                "RaidContinueChallenge": { "max_hit": "{次数}" }
            }
        },
        // ===================== 自动刷副本·迷宫（摇曳的迷宫）（★#54 按「域 + 行名」选★）=====================
        // 迷宫 / 刷几次 / 使用迷宫加成点数（兼容/进阶）：
        // 原本绑定已删除的「重复刷图」任务，现挂在「自动刷副本」上作单目标刷迷宫用。
        // ★#54 目标模型（修订 #52）★：迷宫**按「域」选**，每个域是一张**异质行列表**；
        //   目标 = 【域 + 行名】，**元素是行名的一部分，不是独立轴**（#52 的元素独立选项已被设备证伪）。
        //   真机三域（16448 实测）：崩坏域（临境域深渊之兽·极/·真/`` + 18 行 深层域{1,2,3}【元素】Lv{50,60,70} + 通往深层之门）、
        //   宝物域（6 行 摇曳的迷宫宝物域【火/水/雷/风/光/暗】）、幽玄域（10 行 幽玄域【{1〜3}…{28〜30}层】）。**本模式没有难度档**。
        // ★两块 case 都【由配置派生】（真源 scene.config.MAZE_DOMAINS / MAZE_ROWS / scene.options.derive_maze_*），
        //   漂移由 scene.drift.maze_option_drift 把守。
        // 用「要刷的副本清单」批量刷（写 `域,行名,次数` 的行）时以清单为准，本组选项不生效。
        //
        // ★FarmFight 用 custom「special_target_fight」(pair=below)★：
        //   与「打哪个难度」同一套安全实现 —— 直接返回迷宫行【战斗】按钮自己的 OCR 框
        //   （点击=框中心、零偏移）。绝不再用旧「迷宫名识别框 + 死偏移」：迷宫列表里
        //   【战斗】与只低 36px 的【推荐编成】极近，偏移一抖就会改掉用户队伍配置。
        //   行名匹配：整行 + 末尾锚定（严格式，绝不命中相邻行），并容忍 OCR 丢 【元素】/Lv../层 片段。
        // ★「打哪个迷宫域」落点 = 数据节点 FarmDomainPick★（不在任何 next 里、永不执行）：
        //   与 FarmFight 的 domain 互补，说明当前选的是哪个域。
        "打哪个迷宫域": {
            "type": "select",
            "default_case": "宝物域",
            "cases": [
                {"name": "崩坏域", "pipeline_override": {"FarmDomainPick": {"recognition": {"type": "Custom", "param": {"custom_recognition": "special_target_fight", "custom_recognition_param": {"domain": "崩坏域", "pair": "below"}}}}, "FarmMazeDomain": {"recognition": {"type": "TemplateMatch", "param": {"template": ["maze/domain_beng_banner.png"], "roi": [0, 760, 340, 315], "threshold": 0.8}}}, "FarmDomainVerify": {"recognition": {"type": "TemplateMatch", "param": {"template": ["maze/domain_beng_head.png"], "roi": [0, 90, 720, 240], "threshold": 0.8}}}}},
                {"name": "宝物域", "pipeline_override": {"FarmDomainPick": {"recognition": {"type": "Custom", "param": {"custom_recognition": "special_target_fight", "custom_recognition_param": {"domain": "宝物域", "pair": "below"}}}}, "FarmMazeDomain": {"recognition": {"type": "TemplateMatch", "param": {"template": ["maze/domain_baowu_banner.png"], "roi": [0, 760, 340, 315], "threshold": 0.8}}}, "FarmDomainVerify": {"recognition": {"type": "TemplateMatch", "param": {"template": ["maze/domain_baowu_head.png"], "roi": [0, 90, 720, 240], "threshold": 0.8}}}}},
                {"name": "幽玄域", "pipeline_override": {"FarmDomainPick": {"recognition": {"type": "Custom", "param": {"custom_recognition": "special_target_fight", "custom_recognition_param": {"domain": "幽玄域", "pair": "below"}}}}, "FarmMazeDomain": {"recognition": {"type": "TemplateMatch", "param": {"template": ["maze/domain_youxuan_banner.png"], "roi": [0, 760, 340, 315], "threshold": 0.8}}}, "FarmDomainVerify": {"recognition": {"type": "TemplateMatch", "param": {"template": ["maze/domain_youxuan_head.png"], "roi": [0, 90, 720, 240], "threshold": 0.8}}}}}
            ]
        },
        "打哪个迷宫行": {
            "type": "select",
            "default_case": "摇曳的迷宫宝物域【火】",
            "cases": [
                {"name": "临境域深渊之兽·极", "pipeline_override": {"FarmFight": {"recognition": {"type": "Custom", "param": {"custom_recognition": "special_target_fight", "custom_recognition_param": {"target": "临境域深渊之兽·极", "domain": "崩坏域", "pair": "below"}}}}, "FarmMazeDomain": {"recognition": {"type": "TemplateMatch", "param": {"template": ["maze/domain_beng_banner.png"], "roi": [0, 760, 340, 315], "threshold": 0.8}}}, "FarmDomainVerify": {"recognition": {"type": "TemplateMatch", "param": {"template": ["maze/domain_beng_head.png"], "roi": [0, 90, 720, 240], "threshold": 0.8}}}}},
