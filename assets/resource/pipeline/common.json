    // ==========================================================================
    // ★#67 领主战页面上的「讨伐完成」奖励弹窗 —— 全项目唯一一份（公共节点）★
    //
    // 缺陷（真机 127.0.0.1:16448，#33 part-B 批量跑）
    // -------------------------------------------------
    //   领主战清单【开跑前】就停在一张待处理的奖励弹窗上，整屏 OCR 只有：
    //       讨伐完成 [84,436,552,110]   /   关闭 [326,957,67,39]
    //   清掉它之后，同一屏 OCR = 【战阵之宴 RAID 页】—— 即这是**战阵之宴的奖励弹窗**，
    //   它落在了领主战页面（上一件事是刷战阵之宴）上。
    //   此前 special_dungeon.json 没有任何节点认它 → 领主战清单在第一帧就被它挡住、
    //   在前一帧无进展地空滚到超时（战阵之宴链 raid.json 只认 ^关闭$，领主战链却没有对应节点）。
    //
    // 处置：把「讨伐完成 + 关闭」这条判据收敛成【公共节点】，两处**共用同一份** ——
    //   · 领主战枢纽：special_dungeon.json::SpecialEntry.next 以 [JumpBack]PubRewardDoneClose
    //     引用（分派表里引公共节点，不是复制判据）；
    //   · 战阵之宴链：raid.json::RaidPopupClose 换成引用本公共与门的薄包装（动作/next 原样）。
    //   于是「同一个事实」只有一份定义（绝不各写一份）。
    //
    // ★点击 = 【关闭】按钮自己的识别框中心（box_index=1 指向按钮叶 + Click target:true）★
    //   绝不用「标题框 + 死偏移」猜按钮位置（本项目的血泪教训：偏移一抖就点到【推荐编成】
    //   之类的地方）。与门同时认标题 + 按钮：只有弹窗完整在屏才动，不会误点别的页面的「关闭」。
    //
    // ★OCR 变体容忍★：标题叶用【子串】「讨伐完成」（不用 ^…$ 锚定）—— 真机标题框很大
    //   （552×110），OCR 可能在标题后带上标点 / 空白，子串匹配不受影响。
    //   按钮叶沿用两端锚定 ^关闭$：真机按钮就是干净的「关闭」二字（与 raid 原判据一致）。
    // ==========================================================================
    "PubRewardDoneText": {
        // 「讨伐完成」奖励弹窗·标题判据（子串，容忍标题后附带标点/空白）：仅作子识别。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["讨伐完成"] }
        }
    },
    "PubRewardDoneBtn": {
        // 「讨伐完成」奖励弹窗·【关闭】按钮判据（真机 [326,957,67,39]）：仅作子识别。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["^关闭$"] }
        }
    },
    "PubRewardDoneClose": {
        // 「讨伐完成」奖励弹窗 → 读后动：And 同时认标题 + 【关闭】，box_index=1 输出【关闭】框，
        // Click target:true 即点该框中心（零死偏移）。叶子型：点掉后弹窗消失、自然不再命中。
        "recognition": {
            "type": "And",
            "param": { "all_of": ["PubRewardDoneText", "PubRewardDoneBtn"], "box_index": 1 }
        },
        "action": { "type": "Click", "param": { "target": true } },
        "post_delay": 800,
        "next": []
