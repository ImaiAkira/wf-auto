{
    // PubReturnHome：归位（#8 提升为通用事件）—— 由 scene.events 声明，#10 落进 pipeline。
    // 判据/动作照抄 recover.json::RecoverTapMainCityNav。
    // ★#18 修正：兜底型判据不得自匹配目标状态★
    //   原判据只认底部导航「主城」（OCR ^主城$ + ROI [0,1180,720,100]）。但主城页常驻的
    //   底部导航标签「主城」实测 720 box=[157,1248,44,25]、中心 (179,1260) 正落在该 ROI 内
    //   → 在主城上【必然自匹配】→ 作为优先前缀注入时点空 → [JumpBack] 重扫 → 死循环
    //   （#13 真机实证：370 节点全 PubReturnHome、7 分钟没离开主城）。现改为 And：
    //     · ^主城$ 在底部导航 ROI —— 「回主城」入口（底部导航）还在；
    //     · ^返回$ 在底部导航【最左槽】ROI [0,1180,110,100] —— 说明当前是【非主城】子页面
    //       （主城页最左槽是「主角色」；列表页 / 详情页最左槽是「返回」，实测 r1/r2/r3）。
    //   于是归位只在非主城页面命中，在主城上恒不命中（不再自匹配）。
    //   box_index=0 让点击仍落在「主城」标签框中心 —— 动作与原来一致，只是入口收紧。
    // ★#29 进一步收紧★：#18 的两叶 And 在【链上步骤页面】上仍成立（列表页 / 详情页也有
    //   「返回 + 主城底导」）→ 兜底归位在「目标行在屏幕外」时抢跑，滚动找行的
    //   SpecialScrollList 永不执行。追加第三条子识别 PubReturnHomeOtherSection：当前一级
    //   分区不是主城（底导里另一个分区页签橙色高亮）。主城分区的任何页面（含链上所有步骤页）
    //   都是「主城」页签高亮 → 第三条为假 → 归位不命中。
    "PubReturnHomeText": {
        // 归位判据·子识别①：底部导航「主城」（回主城入口还在）。仅作 PubReturnHome 的子识别。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["^主城$"], "roi": [0, 1180, 720, 100] }
        }
    },
    "PubReturnHomeBackTab": {
        // 归位判据·子识别②：底部导航【最左槽】「返回」—— 说明当前是【非主城】子页面；
        // 主城页最左槽是「主角色」、没有「返回」（实测 pre_shot vs r1/r2/r3）。这是把主城排除掉的那条。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["^返回$"], "roi": [0, 1180, 110, 100] }
        }
    },
    // 归位判据·子识别③（#29）：当前一级分区**不是主城**。
    //   #29 真机实证：领主战列表页 / 详情页同样「有主城底导 + 有返回」→ 仅凭前两条
    //   会让归位在这些【链上步骤页面】上自匹配：目标行在屏幕外时 SpecialEnterBoss 不命中
    //   → 兜底归位抢跑 → 点主城 → 枢纽重进；而滚动找行的 SpecialScrollList 永不执行。
    //   MAA 识别没有 Not，故用【正向】判据表达「不在主城分区」：底部导航里**另一个**
    //   一级分区页签处于选中态（橙色高亮）。底导六槽 [上下文][主城][角色][商店][扭蛋][菜单]，
    //   仅被选中一级分区页签是橙色、其余灰。主城分区的**任何**页面（含链上所有步骤页）
    //   都是「主城」页签高亮、其余四槽灰 → 本判据为假 → 归位不命中。
    //   实测（真机 127.0.0.1:16385，720 空间；见 tools/contract_hooks/hooks_29.py）：
    //     主城分区页四个其它页签橙色像素 = 0；扭蛋分区页「扭蛋」页签 = 918。
    //   ROI = 各页签标签框；lower/upper = 选中态橙色；count 阈值远低于实测值、远高于 0。
    //   ★为什么拆成四个具名 ColorMatch 子节点 + 具名 Or★：MAA 5.13.1 对 Or.any_of 里的
    //   【内联】识别对象会退化成 DirectHit（实测），故这里一律用具名节点引用（字符串）。
    "PubReturnHomeTabChar": {
        // 子识别③-a：底导「角色」页签处于选中态（橙色）→ 当前在角色分区。
        "recognition": { "type": "ColorMatch", "param": { "roi": [275, 1244, 46, 29],
            "method": 4, "lower": [190, 90, 0], "upper": [255, 205, 115], "count": 50 } }
    },
    "PubReturnHomeTabShop": {
        // 子识别③-b：底导「商店」页签选中（橙色）。
        "recognition": { "type": "ColorMatch", "param": { "roi": [397, 1246, 43, 26],
            "method": 4, "lower": [190, 90, 0], "upper": [255, 205, 115], "count": 50 } }
    },
    "PubReturnHomeTabGacha": {
        // 子识别③-c：底导「扭蛋」页签选中（橙色）。
        "recognition": { "type": "ColorMatch", "param": { "roi": [516, 1246, 45, 26],
            "method": 4, "lower": [190, 90, 0], "upper": [255, 205, 115], "count": 50 } }
    },
    "PubReturnHomeTabMenu": {
        // 子识别③-d：底导「菜单」页签选中（橙色）。
        "recognition": { "type": "ColorMatch", "param": { "roi": [636, 1248, 45, 25],
            "method": 4, "lower": [190, 90, 0], "upper": [255, 205, 115], "count": 50 } }
    },
    "PubReturnHomeOtherSection": {
        // 子识别③：其余四个一级分区页签里有一个处于选中态 = 当前**不在主城分区**。
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "PubReturnHomeTabChar",
                    "PubReturnHomeTabShop",
                    "PubReturnHomeTabGacha",
                    "PubReturnHomeTabMenu"
                ]
            }
        }
    },
    "PubReturnHome": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "PubReturnHomeText",
                    "PubReturnHomeBackTab",
                    "PubReturnHomeOtherSection"
                ],
                "box_index": 0
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "post_delay": 500,
        "next": []
    },

    // 公共识别节点 —— 供 agent 里的自定义识别器通过 context.run_recognition 复用。
    // 不入任何 next 分派，只作为「入口节点」被 run_recognition 调用。
    //
    // OcrTask：全屏 OCR（expected [".*"] 即返回所有文本框）。
    //   agent/my_reco.py 的 stage_next / stage_all_done / next_stage 都默认用它取图，
    //   而此前项目里并没有任何节点叫 OcrTask —— 所以那套「已打关卡记录」其实一直
    //   取不到 OCR 结果（静默失败）。这里补上，主线与外传的账本机制才真正可用。
    "OcrTask": {
        "recognition": {
            "type": "OCR",
            "param": { "expected": [".*"] }
        },
        "action": { "type": "DoNothing", "param": {} }
    },

    // PubClick：通用「按框点击」入口 —— 由 agent 通过
    //   context.run_action("PubClick", box=(cx-1, cy-1, 2, 2))
    // 调用（box 为 720 空间；target=true 表示点框中心）。不入任何 next 分派。
    // ★为什么需要它（真机实测）★：部分 MaaFramework 原生库（MFAAvalonia 随包）未导出
    //   ``MaaControllerPostClickV2``，Python binding 的 ``controller.post_click`` 会直接
    //   ACCESS_VIOLATION 崩溃（2026-09-28 log-20260928 里 18 连崩的堆栈）。
    //   改走框架原生 Click 动作则版本无关、且无需 ctypes 直连。PhantomClick 是同一招，
    //   保留兼容；新增代码统一用本节点。
    "PubClick": {
        "recognition": { "type": "DirectHit", "param": {} },
        "action": { "type": "Click", "param": { "target": true } }
    },

    // AutoSwitchLabel：编队页 / 房间页「自动」按钮的**标签裁片**（#56 二批）。
    //   「自动」这个东西**不同页面位置不同**（编队页左下 (142,1062) / 共斗房间页右上
    //   (630,102)），所以绝不能写死坐标 —— 自定义识别 auto_switch_state / auto_switch 经
    //   context.run_recognition("AutoSwitchLabel", image) 复用它来**定位**标签框，
    //   再由标签框推出状态探针与点击点（模板优先，OCR 整串 ^自动$ 兜底）。
    //   裁片自证/跨帧（离线 ZNCC）：1.000 @(142,1062)（编队页，两张已入库真机帧）；
    //   五重编队页 0.997 / 深渊EX 0.997（同位置）。
    //   不入任何 next 分派，只作为 run_recognition 的入口节点。
    //
    //   ★#108★ 为什么这里必须有 roi + 显式 order_by（缺一个就会真机点错）★
    //   （1）threshold 是**入闸门**（"这个位置算不算命中"），**不是"取最高分"**；多结果时选哪个
    //       由 order_by + index 决定，**缺省 Horizontal + 0 = 最左**，不是最像。
    //   （2）没有 roi = 全屏候选池 = 把**同排兄弟控件「自动续战」**也放进来：真「自动」
    //       1.0000@x=142、假「自动续战」0.8964@x=17（两张已入库真机帧实测），两人都过 0.75
    //       ⇒ 默认语义下**必选 x=17**（[17,1062,43,26] 那次误点，机制上就是这么发生的）。
    //       旧注释写的「自动续战最高 0.470」是**尺度不一致**测出来的假数，真机是 0.8964。
    //   （3）roi [100,1030,130,90] = **只框「自动」那一栏**（720 空间）：它完整包含正例窗口
    //       (142,1062,43,26)（四边余量 42/45/32/32px），而左边界 100 把「自动续战」整栏
    //       （标签 x≈17..97）排除 → roi 内 ≥0.75 的候选**只剩「自动」一个**。
    //       副作用（如实登记）：房间页右上 (630,102) 落在 roi 外 → 房间页改走 OCR ^自动$ 兜底。
    //   （4）order_by: "Score" 是**语义防线**：要"最像"而不是"最左"；roi 已让候选取一，但这一条
    //       写死才能兜住将来 roi 放宽 / 框架默认值变更。真源 scene/auto_switch.py 的
    //       AUTO_LABEL_ROI / AUTO_ORDER_BY，两处必须逐项相等（守卫 hooks_108）。
    "AutoSwitchLabel": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["auto/switch_label.png"],
                "threshold": 0.75,
                "roi": [100, 1030, 130, 90],
                "order_by": "Score"
            }
        },
        "action": { "type": "DoNothing", "param": {} }
    },

    // ==========================================================================
    // 公共「换日弹窗」—— 全项目唯一一份
    //
    // 背景：此前 9 个 pipeline 各写了一份完全相同的「日期变了」弹窗逻辑
    // （Raid/Farm/Push/Pull/Gacha/Side/Special/Recover/Phantom *DailyPopup），
    // 现已收敛到这里，避免以后各自改动导致行为不一致。
    //
    // ★调用方式（真机实测过的写法，别自己猜）★
    //   调用者 next 里写 "[JumpBack]PubDailyPopup"（前缀形式）。
    //   —— 普通名字引用本来就是跨文件；加上 [JumpBack] 前缀表示「执行完这个
    //      子链后回到调用者 next 从头重扫」。
    //   ✗ 不要用 anchor:true ✗：那是另一套「锚点表」机制，名字必须被某个节点用
    //     anchor 字段设过，没设过会被静默跳过（实测 get_pipeline_data failed）。
    //
    // ★本节点是【叶子型】★
    //   next 必须为 []：处理完（点掉弹窗）后弹窗消失 → 自然不再命中。
    //   绝不能把 next 指向本文件/任何分派器（否则永不返回 = 白写）。
    //
    // ★循环风险与取舍★
    //   正常情况：命中→点 OK→弹窗消失→重扫不再命中，不会循环。
    //   极端情况：若输入冻结导致点了 OK 弹窗也不消失，本节点会以 ~1.7s 节奏重复点击。
    //     这里【故意不设 max_hit】：它虽是节点级、但任务内全局共享，设上限会在长任务里
    //     「用满即静默跳过」→ 之后真正的换日弹窗也无人处理（比重复点击更糟）。
    //     重复点击在输入恢复后往往能自行成功，故保留【无限重试】语义。
    //     已知取舍：调用它的分派链把本节点放在最前，因此上述「弹窗不消失」时它会挡住
    //     其后的卡死自恢复节点（side/special/phantom）—— 这是「最临时全局打断优先」的代价。
    //
    // ★判据保持精确★：^日期变了$（绝不宽匹配，否则会误点该弹窗的「返回标题」
    //   把游戏踢回标题页 —— 历史踩过的坑）。
    //   必须【同时】命中标题 ^日期变了$ + 按钮 ^OK$ 才动（双保险，确保弹窗完整在屏）。
    //   ★点击目标固定两点式 [359,823] = 【OK】按钮中心★
    //   （【返回标题】在 (359,592)，绝不可点；真实样本 date_16384.png）。
    // ==========================================================================
    "PubDailyText": {
        // 「日期变了」弹窗·标题判据：仅作 PubDailyPopup 的子识别。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["^日期变了$"] }
        }
    },
    "PubDailyOk": {
        // 「日期变了」弹窗的【OK】按钮：直接 OCR 按钮文字本身（绝不点返回标题）。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["^OK$"] }
        }
    },
    "PubDailyPopup": {
        // 公共换日弹窗：全局打断，任何画面下都可能弹。调用者用 [JumpBack] 前缀调用。
        "recognition": {
            "type": "And",
            "param": { "all_of": ["PubDailyText", "PubDailyOk"] }
        },
        "action": { "type": "Click", "param": { "target": [359, 823] } },
        "post_delay": 1500,
        "next": []
    },

    // ==========================================================================
    // 公共「加载等待」—— 全项目唯一一份
    //
    // 背景：此前 7 个 pipeline 各写了一份完全相同的「请耐心等待」等待逻辑
    // （Push/Gacha/Pull/Raid/Recover/Side/Special 各自的 *LoadingWait），
    // 现已收敛到这里，避免以后各自改动导致行为不一致。
    //
    // ★调用方式（与 PubDailyPopup 同一套写法，实测过的）★
    //   调用者 next 里写 "[JumpBack]PubLoadingWait"（前缀形式）。
    //   —— [JumpBack] 表示「执行完这个子链后回到调用者 next 从头重扫」。
    //   ✗ 不要用 anchor:true ✗：那是另一套「锚点表」机制，名字没被设过锚点会被
    //     静默跳过（与前一轮换日弹窗踩过的坑相同）。
    //
    // ★本节点是【叶子型】★
    //   next 必须为 []：它只等待、绝不改变画面，靠画面自己从加载页变成别的页来退出。
    //   绝不能把 next 指向任何分派器（否则永不返回 = 白写）。
    //
    // ★判据保持精确/半精确★："请耐心等待"（4 字特征文案，非宽匹配）。
    //   真实加载页实测 OCR = "请耐心等待"（如 ph_w_0544_loading.png 720 (594,1217)）。
    //   子识别 PubLoadingText 同时供 recover.json 的「期望画面」Or 判定复用。
    //
    // ★已知风险★：本节点是纯等待（DoNothing），绝不点击。
    //   正常情况：加载完画面变化 → 重扫不再命中 → 继续后续流程。
    //   极端情况：若画面永远停在加载页（网络卡死 / 游戏 hang），本节点会一直命中，
    //     每 post_delay 秒空等一次、永不前进。有卡死自恢复节点的调用者（side/special
    //     的 *StallRecover，stall_recover 默认 180s）里，本节点均排在卡死节点【之后】，
    //     不会挡住 stall 兜底；无 stall 节点的调用者（如 recover）则与原
    //     RecoverLoadingWait 行为一致（加载页不动就一直等）。加载页通常几秒内就会变化，
    //     实测未出现永久停留。
    // ==========================================================================
    "PubLoadingText": {
        // 「请耐心等待」加载页判据：PubLoadingWait 的子识别；也供 recover 复用。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["请耐心等待"] }
        }
    },
    "PubLoadingWait": {
        // 公共加载等待：只等待、不点击（见上方说明）。调用者用 [JumpBack] 前缀调用。
        // post_delay 沿用原来的 3000（auto_push 原为 5000，统一为 3000：纯等待节点
        // 恢复得更勤快一些；加载页仍在 → 会再次命中，行为等价）。
        "recognition": {
            "type": "And",
            "param": { "all_of": ["PubLoadingText"] }
        },
        "action": { "type": "DoNothing", "param": {} },
        "post_delay": 3000,
        "next": []
    },

    // ==========================================================================
    // 公共「战斗中」判据 —— 全项目唯一一份（★★历史最危险的坑，改动前必读★★）
    //
    // 背景：此前 5 个 pipeline 各写了一份完全相同的「战斗中」判据
    // （Push/Farm/Raid/Side/Special 各自的 *BattleTime/*BattleScore/*BattleWait），
    // 现已把【判据本身】收敛到这里，避免以后各自改动导致行为不一致。
    //
    // ★★为什么必须带格式（血泪教训，绝对不许改回裸词）★★
    //   早期判据用的是【裸】「时间」「分数」两个词：
    //     结算页的奖励条目里同时含有「战斗分数」和「最长滞空时间6秒」，
    //     于是「等战斗结束」在结算页恒为真 → 任务空转 32 分钟、1244 圈，
    //     永远轮不到结算推进节点（真实事故，见 raid.json 坑点 6）。
    //   修法就是【带格式】（原样照搬历史修好的版本）：
    //     时间 \d+:\d+   —— 战斗 HUD 实测「时间 09:53」
    //     分数 \d         —— 战斗 HUD 实测「分数 00000082254」
    //   也【不能】用 ^时间$：战斗 HUD 是「时间 09:53」整体一个文本框，不是独立词，
    //   两端锚定反而永远匹配不上。
    //   ⇒ 改回裸词 = 重新引入 32 分钟死循环，绝对禁止。
    //
    // ★调用方式★
    //   PubBattleTime / PubBattleScore 是【识别型】公共节点：不需要 [JumpBack]，
    //   各文件的组合节点直接在 And.all_of 里写公共名即可（跨文件引用本来就成立，
    //   先例：recover.json 的 Or.any_of 直接引用 PubLoadingText）。
    //   PubBattleWait 是【动作型】公共节点（And + DoNothing + post_delay），
    //   如需整组复用，用 "[JumpBack]PubBattleWait" 调用（叶子型，next: []）。
    //
    // ★当前 5 个文件为何仍保留各自薄薄的 *BattleWait 包装★
    //   它们的 post_delay 与在分派链里的位置都是实机调过的（Raid 2000 / Side 3000 /
    //   Special 3000 / Push 5000 / Farm 5000），故采取【最小改动】：
    //   保留本文件的 *BattleWait 外壳，只把 all_of 的子识别换成
    //   PubBattleTime / PubBattleScore。这样判据唯一、行为零变化。
    //   注意：Raid/Special 的 *BattleWait 在分派链里必须【靠后】，
    //   否则结算页的宽松等待会挡住结算推进节点（见 raid.json 坑点 6）。
    // ==========================================================================
    "PubBattleTime": {
        // 战斗中 HUD「时间 09:53」判据。★必须带格式，见上方血泪教训★
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["时间 \\d+:\\d+"] }
        }
    },
    "PubBattleScore": {
        // 战斗中 HUD「分数 00000082254」判据。★必须带格式，见上方血泪教训★
        "recognition": {
