    // ==========================================================================
    // ★「体力不足 → 星岛石恢复」—— 跨场景弹窗（五重 / 战阵之宴 / 领主战族 / 深渊共用一份）★
    //
    // 运维裁决（settled）：「需要补的，因为五重会消耗体力」；「★只用星岛石恢复★」。
    //   五重决战 / 战阵之宴 / 领主战族 / 深渊连战在开打时都消耗体力；体力不足时游戏弹
    //   「回复体力」弹窗（标题「回复体力/体力不足」、副标题「请选择要使用的道具」，选项
    //   体力回复药（小/中/大）与 ★星导石 × 50（回复 100 体力）★，底部红条「取消」）。
    //   此前 pipeline 没有任何节点认它 → 流程停在弹窗上空等，直到各场景的有界收工把它停掉。
    //
    // ★策略（唯一声明处 = scene/stamina.py）★：**只用星岛石恢复** —— 识别到弹窗即点
    //   「星导石 × 50」那一行 → 二次确认框点 OK → 结果窗「体力回复了！」点 OK（★三步★；
    //   第三步：真机A 第四跑实测确认 OK 后会弹「体力回复了！」结果窗、此前无节点认它 →
    //   五重空转到「未知画面 121 次」兜底；现作为恢复链第一类参与的第三态处理）。
    //
    // ★数据 / 接线★：短语与节点名唯一真源是 scene/stamina.py；各链（wuchong / raid /
    //   special_dungeon / abyss）只以 [JumpBack]PubStamina* 引用。一致性由
    //   tools/contract_hooks/hooks_stamina.py 把守（配置 ↔ 接线不同步即红）。
    //
    // ★读后动、零死偏移★：动作节点一律 And(弹窗, 目标) + box_index=1 → Click target:true，
    //   点的是那一行 / 那个按钮**识别框中心**（旧线用死坐标，本项目禁止）。
    //   ★绝不点【取消】★（只会退回上一页、下一轮再弹）；★容忍 星导石/星岛石 两种写法★。
    //
    // ★排在看门狗之前★：静止的弹窗帧不得被卡死看门狗当成「卡死」而重开游戏。
    //
    // ★诚实边界★：判据取自旧线真机帧 + 本线真机A 帧；本线**未主动制造**「体力不足」状态
    //   （账号体力接近上限），但第四跑真机A 已**自然到达**该流程并覆盖到第三态结果窗 →
    //   仍以离线验证为主（判据 / 接线 / 策略 + prove-red + 真机帧回放）。
    //   ★历史更正★：旧注释「本票未处理第三态结果窗（五重点 OK 后关卡直接开打）」被真机A
    //   第四跑证伪 —— 该结果窗确实出现、且此前无节点认它（见 PubStaminaDone* 定义）。
    // ==========================================================================
    "PubStaminaInsufficientText": {
        // 回复体力弹窗·正文叶（真机帧副标题「请选择要使用的道具」；并容忍「体力不足」标题变体）。
        // 仅作 PubStaminaUseStone 的子识别。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["请选择要使用的道具", "体力不足"] }
        }
    },
    "PubStaminaStoneText": {
        // 「星导石 × 50」那一行的行名叶（★容忍 OCR 变体：星导石 / 星岛石★）。
        // roi 圈定弹窗选项区那一行，避开二次确认框标题与别的页面同名文字。★必须与
        // scene/stamina.py 的 STONE_ROW_ROI 相等★（hooks_stamina / hooks_74_stamina 钉住）。
        // ★真机A 重标（2026-10-16，第三次 run）★：旧值 [180,900,420,80] 取自旧线帧
        // （行在 y≈934）；本线真机弹窗「星导石×50」实测 box=[209,873,160,32]（行跨 y
        // 873..905）→ 跨在旧 ROI 上边界外、被裁剪后永不命中 → 体力永不恢复、五重空转
        // 121 次后兜底收工（见 tools/frames/stamina_insufficient_wuchong_a.png）。
        // 故意放宽 y 840..1000（而非只挪 ~30px），容忍布局 / 内边距漂移；x 维持 180..600
        // （数量文字 x≈518..645 仍被排除）。仅作子识别。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["星导石", "星岛石"], "roi": [180, 840, 420, 160] }
        }
    },
    // ★#102 P0-1★ 「星导石行」的**模板通道**（模板优先 / OCR 兜底）—— 真源 scene/templates.py
    //
    // 为什么加（D3 的复查）：行名 OCR 要**同时**容忍 星导石 / 星岛石 两种写法，这本身就是
    //   「我们知道它会读错」的自白（调研 §2.1 D3）；而 `^星导石$` 的失败形态是**静默**的
    //   （#74 真机：ROI 差 30px → 行被裁掉 → 永不命中 → 五重空转 121 次后兜底收工）。
    //   模板读的是**图形**，与字形/写法无关。
    //
    // 判据 = 那一行的**物品图标**（彩虹球，720 (82,877,103,88)），不是文字、也不是 ×50 数量：
    //   数量是「持有 2753425」会变（调研 N1：内容会跳变的不许进模板），带进去明天就失效。
    //
    // ★数字（真机帧实测，全滑窗 TM_CCOEFF_NORMED；存档在 scene/templates.py）★
    //   正例 stamina_insufficient_wuchong_a.png：**1.0000 @(82,877)**（灰/彩同分，自证）；
    //   负例 6 帧 ROI 内最高 **0.2779**（灰 0.2716 / 彩 0.2779）→ 阈值 0.85 余量 **0.5721**；
    //   ★ROI 外的危险高分★：同一个彩虹球在 ark62_detail_unpairable.png 的【首次报酬】上
    //   灰 **0.7734 @(530,439)**、lord_team_page.png 上 **0.7805 @(568,269)** ——
    //   **全屏 ROI 会直接假阳**，所以 roi 是承重防线，不是顺手写的。
    "PubStaminaStoneIcon": {
        // 星导石行·物品图标叶（TemplateMatch）。★roi 只框图标那一栏★：x 66..200
        // （行名起 x≈209、数量起 x≈518 都被排除），y 852..988 留 ±23px 余量（#74 的 30px 教训）。
        // ★order_by: Score 显式★：要「最像」，绝不吃默认 Horizontal（取最左）。
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["common/stamina_stone_icon.png"],
                "threshold": 0.85,
                "roi": [66, 852, 134, 136],
                "order_by": "Score"
            }
        }
    },
    "PubStaminaStoneRow": {
        // ★双通道叶★：模板优先、OCR 兜底。Or 的语义是「命中第一个即成功，后续不再识别」
        //（协议 .research/3.1-pipeline.md:858-860）⇒ 顺序即优先级。
        // ★OCR 兜底一字不改★：PubStaminaStoneText 仍是 OCR + ["星导石","星岛石"] + 原 roi
        //（hooks_stamina / hooks_74_stamina 钉住它；本票**没有**删 OCR）。
        // ★输出框★：谁命中就用谁的框 —— 模板命中 ⇒ 图标框（中心 (138,916)，在同一行卡片内）；
        //   OCR 命中 ⇒ 行名框（中心 (289,889)，与改动前**完全相同**）。两种落点都在行内、都可点行。
        "recognition": {
            "type": "Or",
            "param": { "any_of": ["PubStaminaStoneIcon", "PubStaminaStoneText"] }
        }
    },
    "PubStaminaUseStoneTpl": {
        // ★第一步（模板通道）★：And(弹窗正文 + 双通道行) box_index=1 → 点该行框中心（零死偏移）。
        // 叶子型（next=[]）：点掉后弹二次确认框，自然不再命中。
        // ★为什么是一个**新节点**而不是直接改 PubStaminaUseStone★：后者被
        //   hooks_stamina（node_failures: all_of 逐项 == [正文, 星导石行]）与
        //   tools/verify_stamina_frames.py（输出框 == 真机行框 [209,873,160,32]）双向钉死，
        //   box 语义一变两条守卫都红。⇒ 新节点 + 在 next 候选里排在 OCR 版**之前**，
        //   得到「模板优先、OCR 兜底」而**不动**已被钉住的语义。
        // ★接线现状（2026-10-18 更新）★：已接进**全部 7 个消费链枢纽** —— side_story.json 的
        //   SideStoryEntry / SideClearEntry、abyss.json::AbyssEntry、auto_push.json::AutoPush、
        //   raid.json::RaidDispatch、special_dungeon.json::SpecialEntry、wuchong.json::WuchongEntry
        //   + wuchong_scene.json::WuchongGuardChain（#102）。一律 [JumpBack] 排在 OCR 版**之前**。
        //   枢纽清单的真源 = scene.stamina.STAMINA_CONSUMING_CHAINS（hooks_102 逐枢纽对账）。
        "recognition": {
            "type": "And",
            "param": { "all_of": ["PubStaminaInsufficientText", "PubStaminaStoneRow"], "box_index": 1 }
        },
        "action": { "type": "Click", "param": { "target": true } },
        "post_delay": 1500,
        "next": []
    },
    "PubStaminaUseStone": {
        // ★第一步★：And(弹窗正文 + 「星导石」行) box_index=1 → 点【星导石行】框中心
        // （零死偏移）。叶子型：点掉后弹二次确认框（不消失则由下一节点接）。
        "recognition": {
            "type": "And",
            "param": { "all_of": ["PubStaminaInsufficientText", "PubStaminaStoneText"], "box_index": 1 }
        },
        "action": { "type": "Click", "param": { "target": true } },
        "post_delay": 1500,
        "next": []
    },
    "PubStaminaConfirmText": {
        // 二次确认框标题叶（旧线实测「点星导石 × 50 → 弹『是否消耗星导石回复体力?』→ 点 OK
        // 才生效」；★同样容忍 星岛石★）。仅作子识别。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["是否消耗星(导|岛)石回复体力"] }
        }
    },
    "PubStaminaOkText": {
        // 二次确认框【OK】按钮叶（两端锚定 ^OK$；roi 圈定右侧按钮，避开左侧【取消】）。仅作子识别。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["^OK$"], "roi": [430, 770, 290, 90] }
        }
    },
    "PubStaminaConfirmOk": {
        // ★第二步★：And(确认框标题 + OK) box_index=1 → 点【OK】框中心（左【取消】绝不点）。
        // 这一步才真扣星导石、体力 +100，随后关卡开打。叶子型。
        "recognition": {
            "type": "And",
            "param": { "all_of": ["PubStaminaConfirmText", "PubStaminaOkText"], "box_index": 1 }
        },
        "action": { "type": "Click", "param": { "target": true } },
        "post_delay": 2500,
        "next": []
    },
    "PubStaminaDoneText": {
        // 结果窗·正文叶（★第三步★）：真机A 第四跑（2026-10-16）实测 —— 二次确认 OK 之后
        // 游戏**确实**弹出「体力回复了！」结果窗（带 OK 按钮）；此前无节点认它 → 五重空转
        // WuchongEntry/WuchongWait 数分钟、state 恒 unknown，最终「未知画面累计 121 次」收工。
        // 证据帧 tools/frames/stamina_recovered_done_wuchong_a.png（OCR [267,424,168,36]）。
        // 子串（容忍尾部标点）；★只在本屏出现，与「体力回复药」不混（药无『了』）★。仅作子识别。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["体力回复了"] }
        }
    },
    "PubStaminaDoneOkText": {
        // 结果窗·【OK】按钮叶（真机A OCR [333,805,53,37]——在**中心左侧**）。两端锚定 ^OK$。
        // ★自有 ROI（x 290..450）★：完整包含结果窗 OK，且**排除确认框 OK（x≈496）** ——
        // 两屏 OK 的 x 区间不重叠，各用各的 ROI（hooks_stamina_done 钉互不误命中）。
        // ★必须与 scene/stamina.py 的 DONE_OK_ROI 相等★（hooks_stamina / hooks_stamina_done 钉住）。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["^OK$"], "roi": [290, 770, 160, 90] }
        }
    },
    "PubStaminaDoneOk": {
        // ★第三步★：And(结果窗正文 + OK) box_index=1 → 点【OK】框中心（零死偏移、读后动）。
        // 叶子型：点掉后结果窗消失、自然不再命中（幂等）。排在「恢复链」确认步之后。
        "recognition": {
            "type": "And",
            "param": { "all_of": ["PubStaminaDoneText", "PubStaminaDoneOkText"], "box_index": 1 }
        },
        "action": { "type": "Click", "param": { "target": true } },
        "post_delay": 1500,
        "next": []
    }
}
