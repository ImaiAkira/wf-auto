        //   scene.chain.结算终点）。此前单目标打满后无任何东西指向本节点 → 只能在
        //   主城 ↔ 列表 ↔ 详情 之间无限重进（#13 实证约 60 轮）。
        "recognition": { "type": "DirectHit", "param": {} },
        "action": { "type": "StopTask", "param": {} },
        "post_delay": 1000,
        "next": []
    },
    "PhantomDispatch": {
        // 【幻想连战·种类分派器】只在当前种类 = phantom 时命中（BatchModeRecognition）。
        // 命中后按下面的 next 走 phantom.json 的幻想状态机链（与原 PhantomEntry.next 一致）；
        // 链上每个节点跑完都回 SpecialEntry，由指挥官（SpecialBatchPlan）再评估
        // 「这一条幻想目标是否已刷够套数」，从而切下一条 / 收工。
        //   · 单目标「自动刷幻想」：入口 PhantomEntry（别名→SpecialEntry）、清单为空，
        //     种类由入口决定 = phantom → 本分派器命中，跑回与合并前完全一致的幻想法。
