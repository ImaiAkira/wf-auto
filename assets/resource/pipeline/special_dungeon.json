    "SpecialStallRecover": {
        // 【卡死自恢复·需求 #3】画面连续 N 秒无变化 → 判定卡死 → 重开游戏拉回主城。
        // 阈值复用 interface「无响应重开阈值」（默认 180s），不新造一套。
        // 放在分派表很靠前（紧随公共换日弹窗），保证每轮都评估（详见 side_story.json 的 SideStallRecover）。
        //
        // ★恢复动作为什么用 restart_game（而不是 StopTask）★
        //   特殊副本流程【有】主城导航（SpecialOpenLord 等），restart_game 把游戏拉回
        //   主城后，pipeline 能自己重新导航到领主战继续，真正做到「恢复」而不是「收工」。
        //   与安全红线「卡住优先 recover_game.py」一致（restart_game = 同一套强杀重开流程）。
        // ★误报风险★：识别/等待节点不动画面；只有当加载页/战斗页真的静止超阈值
        //   （游戏 hang）才会命中并重开，属预期兜底。正常流程画面在动，不会误触发。
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "stall_recover",
                "custom_recognition_param": { "threshold_sec": 180 }
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "restart_game",
                "custom_action_param": {
                    "pkg": "com.leiting.wf",
                    "restart_wait": 35,
                    "login_wait": 20,
                    "start_wait": 35,
                    "force_stop_wait": 3,
                    "nav_wait": 4
                }
            }
        },
        "post_delay": 1000,
        "next": [
            "[JumpBack]PubLoadingWait",
            "[JumpBack]PubDailyPopup",
            "[JumpBack]PubLevelUpContinue",
            "[JumpBack]PubNewCharTap",
            "[JumpBack]PubSkipStory",
            "[JumpBack]PubChallenge",
            "[JumpBack]SpecialBonusNo",
            "[JumpBack]SpecialRecruitOpen",
            "[JumpBack]PubReturnHome",
            "SpecialEntry"
        ]
    },
    "SpecialBatchPlan": {
        // 【批量副本清单·指挥官】agent 侧 custom_recognition "special_batch_plan"。
        // 清单文本由 interface「要刷的副本清单」通过 custom_recognition_param.list 注入。
        //   · box=None  → 不命中：清单为空（回退单目标）或当前目标正常推进中；
        //   · box=[0,0,0,0] → 命中：执行下面的 action（点底部「主城」归位），
        //     然后 next 决定「回 SpecialEntry 继续下一个」还是「走 SpecialBatchStop 收工」。
        // 由识别器在运行时用 context.override_next 改写 next。
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "special_batch_plan",
                "custom_recognition_param": { "list": "" }
            }
        },
        // 命中即点底部「主城」(实测 720 (179,1260))，两点式 target（铁律 3）。
        // 归位后由 pipeline 自己重新导航到下一个副本，绝不使用返回键。
        "action": { "type": "Click", "param": { "target": [179, 1260] } },
        "post_delay": 2500,
        "next": [
            "[JumpBack]PubLoadingWait",
            "[JumpBack]PubDailyPopup",
            "[JumpBack]PubLevelUpContinue",
            "[JumpBack]PubNewCharTap",
            "[JumpBack]PubSkipStory",
            "[JumpBack]PubChallenge",
            "[JumpBack]SpecialBonusNo",
            "[JumpBack]SpecialRecruitOpen",
            "[JumpBack]PubReturnHome",
            "SpecialEntry"
        ]
    },
    "SpecialBatchStop": {
        // 【批量副本清单·收工】只在「清单全部完成 / 清单解析出错」时被
        // SpecialBatchPlan 通过 override_next 指向，正常分派链里不出现。
        // 前面 SpecialBatchPlan 的 action 已把游戏点回主城。
        // ★#22★ 单目标模式（清单为空）也复用本节点收工：目标打满配置次数后，由
        //   结算动作 special_batch_finish 在【结算帧】通过 override_next 把当前结算
