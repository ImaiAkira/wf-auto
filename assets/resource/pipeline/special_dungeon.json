    // ------------------------------------------------ 编队页「自动」（#56 二批 / ruling ②）
    // ★跨模式硬规则★：「除了五重决战可以选择自动或手动以外，其他所有战斗都需要勾选自动」；
    //   检查点从「战斗内(暂停→自动滑块)」**移到战斗外的编队页/房间页**，且「自动」按钮一律
    //   **定位**（模板/OCR）后读状态、点识别框中心 —— **不同编队页位置不同**（编队页左下
    //   (142,1062) / 共斗房间页右上 (630,102)），绝不写死坐标。本节点经 SpecialEntry 分派，
    //   **覆盖所有模式**（领主战家族 / 幻想连战 / 战阵之宴 / 迷宫）的编队页。
    //   条件门控（auto_switch_state, state=off）→ 只在当前是「关」时命中；命中设「开」后下一帧
    //   不再命中（不进死循环），随后 SpecialChallenge 接管。
    // ★三批根因修复（真机 127.0.0.1:16384 帧自证）★：旧门控是**全屏** ^自动$，**没有页面范围**，
    //   于是它在**战斗/结算画面**上命中了**战斗 HUD 的「自动」**（OCR [15,193,55,19]；与编队页
    //   底栏的「自动」[142,1062,43,26] 是**两个不同控件、不同位置**）→ 动作随后在**转场/加载帧**
    //   上再截频 → 屏上无「自动」→ 旧的「定位不到 … → 不动」静默失败；若动作帧仍是战斗画面，
    //   则点到战斗 HUD 中心（≈(42,202)）→「点后仍未达期望」。两种形态同根：门控未限定页面。
    //   现由 auto_switch_state 强制**编队页/房间页**判据（页面文本锚点 ∨ 开关探针内的 开/关 状态字，
    //   均不含坐标），战斗 HUD 的「自动」永不命中；定位不到改为**可见失败**（[auto_switch][FAIL]）。
    //   证据帧：tools/frames/auto_battle_hud_hit.png（战斗命中帧）+ auto_battle_hud_action.png（加载失败帧）。
    "SpecialTeamAutoSet": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "auto_switch_state",
                "custom_recognition_param": { "label": "自动", "state": "off", "ocr_entry": "OcrTask" }
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "auto_switch",
                "custom_action_param": { "on": true, "scene": "special", "label": "自动", "click_action": "PubClick" }
            }
