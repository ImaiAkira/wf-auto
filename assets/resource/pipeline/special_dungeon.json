        //   与这里的 max_hit 逐字段绑定）。
        // ★#50 有界停止（安全网）★：单条目把一份预算滚完仍未把目标行滚进屏幕（目标行
        //   不在列表里 / 一直滚错页）→ 指挥官明确【跳过该目标并记录原因】，绝不静默空转、
        //   绝不假记账（判定 = side_impl.scroll_budget_exhausted）。
        //   ★为什么这正是「行一旦可见就不再消耗预算」的证据★：SpecialEnterBoss 排在
        //   SpecialScrollList 之前（见 SpecialTabLord/SpecialTabJoss 的 next），行一旦进屏
        //   就被选行、不再走滚动节点 → 预算被滚完只可能是「行始终没进屏」。
        // ★#50 数值上调 30 → 80（每条目）★：上面那条「给 30 就够」的注释是给 15 行【领主战】
        //   列表写的；【降临讨伐】列表比它长/深得多。真机 16448 实测（5 个深行成员一个 chunk）：
        //   成员 3/4 分别要 ~15/~23 次滚动（成员 4 起步时命中数已 20 → 旧的共享 30 只够再滚 10，
        //   必被静默跳过），成员 5 连 30 次都没滚到 → 30 会把最深行误判成「不可达」。
        //   故把每条目预算抬到 80（有界：单条目最多 80 次；够滚完 29 行且有余量）。
        //   守卫 + 离线复现 + prove-red 见 tools/contract_hooks/hooks_50.py。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["更新列表"] }
        },
        "action": {
            "type": "Swipe",
            "param": {
                // ★四元素陷阱修复★ begin/end 必须写成【两元素定点 [x, y]】。
                //   MAA 的四元素形态 [x, y, w, h] 是【区域】——会在矩形内随机取一点
                //   （越靠中心概率越高）；w/h=0 时该区域【延伸到屏幕边缘】（即 [0,0,0,0]
                //   就是全屏，见 deps/tools/pipeline.schema.json 的 Swipe.begin 说明）。
                //   所以旧写法 [360, 1040, 0, 0] → [360, 640, 0, 0] 实际是
                //   [360,720]×[1040,1280] → [360,720]×[640,1280] 的【随机斜向拖拽】：
                //   起点/终点 x 各在 [360,720] 内乱跳（真机日志实证：begin x∈[362,710]、
                //   end x∈[360,714]，dx 常数百像素）。这正是运维看到的
                //   「斜向拉动 + 左右拉去找」。两元素定点则 dx≡0，严格竖直。
                "begin": [360, 1040],
                "end": [360, 640],
                "duration": 800
            }
        },
        "max_hit": 80,
        // ★#42★ 滑动后的稳定等待：受控滚动 400px 之后列表还会带一点惯性，而随后的
        //   选行点击发生在「识别那一帧之后」——给它更长的稳定时间，把「列表仍在滑动时点行」
        //   的窗口压到最小（选行点击自身还会复核一次，双保险；1600 → 2600）。
        //   真机 r9 的错位正是【深行多次滑动】之后紧接着发生的（此时惯性最容易咬人）。
        // ★#42 真机实证（CET-AL00/RANK158）★：降临讨伐列表比领主战长得多（目标行要滑 6+ 次），
        //   期间**出现过『没有经过选行节点、却打开了某个行的详情页』**（帧内那几行是列表
        //   中段的 暗凛机兵 / 闪哭机兵）—— 最可能是 500ms/400px 的「甩动」在抬手时被当成
        //   一次【点行】。故把手势放慢成 800ms（同 400px 行程 = 明确的拖拽而不是甩动），
        //   把「抬手被读成点击」的概率压下去（这一条是**缓解**，不是已证实的修复；
        //   真正的兜底是选行复核 + 详情页身份校验：错页会被拒绝并退回重导航）。
        "post_delay": 2600,
        "next": [
            "[JumpBack]PubLoadingWait",
            "[JumpBack]PubDailyPopup",
            "[JumpBack]PubLevelUpContinue",
            "[JumpBack]PubNewCharTap",
            "[JumpBack]PubSkipStory",
            "[JumpBack]PubChallenge",
            "[JumpBack]SpecialBonusNo",
            "[JumpBack]SpecialRecruitOpen",
            "[JumpBack]PubReturnHome",
            "SpecialEntry"
        ]
    },
    "SpecialOpenLord": {
        // 主城【领主战】入口（实测 (608,1135)）。ROI 限定右下角，避开列表页/详情页的「领主战」文字。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["领主战"], "roi": [480, 1080, 240, 140] }
        },
        "action": { "type": "Click", "param": {} },
        "post_delay": 2500,
        "next": [
            "[JumpBack]PubLoadingWait",
            "[JumpBack]PubDailyPopup",
            "[JumpBack]PubLevelUpContinue",
            "[JumpBack]PubNewCharTap",
            "[JumpBack]PubSkipStory",
            "[JumpBack]PubChallenge",
            "[JumpBack]SpecialBonusNo",
            "[JumpBack]SpecialRecruitOpen",
            "SpecialTabLord",
            "SpecialTabJoss",
            "[JumpBack]PubReturnHome",
            "SpecialEntry"
        ]
    },
    "SpecialTabLord": {
        // 列表页顶部 tab【领主战】(实测 (180,405))。ROI 限于 tab 行，避开列表行里的分类「领主战」。
        // max_hit:1 —— 切一次 tab 即可；不限次会每轮都命中、饿死后面的滚动找副本。
        // 选降临讨伐副本时由选项把本节点 expected 覆盖成 __NONE__（因为「领主战」tab 标签常驻，
        // 不关掉它就会先切回领主战 tab）。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["^领主战$"], "roi": [0, 375, 360, 60] }
        },
        "action": { "type": "Click", "param": { "target": [180, 405] } },
        // ★#19★ 已移除 max_hit:1 —— 页签必须由【目标子族】决定，绝不靠「谁先命中谁用尽次数」竞速。
        //   本节点是【领主战】目标要走的页签（领主战 tab 标签常驻 → 排在 SpecialTabJoss 之前 → 先命中）。
        //   ★重进列表必须重新确认同一页签★：不限次 = 每次回到列表都重新点回领主战 tab，
        //   绝不会因「次数用尽」把页签让给 SpecialTabJoss。
        //   死循环实证（#13 15:21:57 结算后）：首轮用掉唯一一次命中 → 此后每次重进 SpecialTabJoss
        //   抢先 → 列表翻到降临讨伐 → 目标行「八岐大蛇讨伐」不可见 → SpecialEnterBoss 永不命中 →
        //   后缀归位 → 主城 → SpecialOpenLord 重开 → 循环（~4.3s）直到 stall。页签由子族决定后此环消失。
        "post_delay": 1200,
        "next": [
            "[JumpBack]PubLoadingWait",
            "[JumpBack]PubDailyPopup",
            "[JumpBack]PubLevelUpContinue",
            "[JumpBack]PubNewCharTap",
            "[JumpBack]PubSkipStory",
            "[JumpBack]PubChallenge",
            "[JumpBack]SpecialBonusNo",
            "[JumpBack]SpecialRecruitOpen",
            "SpecialEnterBoss",
            // ★#29★ 目标行不在首屏时必须先去【滚动找行】，而不是被兜底归位抢跑。
            //   页签已选中后，若「选目标行」(SpecialEnterBoss) 不命中（目标在屏幕外），
            //   就滚列表（SpecialScrollList）继续找；归位已收紧为「不在主城分区」才命中，
            //   故此处不再被它 hijack（否则 15 行只有首屏 3 行能打，其余循环到超时）。
            "SpecialScrollList",
            "[JumpBack]PubReturnHome",
            "SpecialEntry"
        ]
    },
    "SpecialTabJoss": {
        // 列表页顶部 tab【降临讨伐】(实测 (540,404))。ROI 限于 tab 行。max_hit:1。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["降临讨伐"], "roi": [360, 375, 360, 60] }
        },
        "action": { "type": "Click", "param": { "target": [540, 404] } },
        // ★#19★ 已移除 max_hit:1 —— 同 SpecialTabLord：页签由目标子族决定，重复进入列表必须
        //   重新确认同一页签（降临讨伐目标 = 本节点），绝不因次数用尽而空转 / 翻回领主战。
        //   降临讨伐目标时 SpecialTabLord 被选项覆盖成 __NONE__（见 scene.lord_battle 的子族覆盖），
        //   故本节点是该子族唯一的页签节点；领主战目标则被 SpecialTabLord 抢先，本节点永不触达。
        "post_delay": 1200,
        "next": [
            "[JumpBack]PubLoadingWait",
            "[JumpBack]PubDailyPopup",
            "[JumpBack]PubLevelUpContinue",
            "[JumpBack]PubNewCharTap",
            "[JumpBack]PubSkipStory",
            "[JumpBack]PubChallenge",
            "[JumpBack]SpecialBonusNo",
            "[JumpBack]SpecialRecruitOpen",
            "SpecialEnterBoss",
            // ★#29★ 目标行不在首屏时必须先去【滚动找行】，而不是被兜底归位抢跑。
            //   页签已选中后，若「选目标行」(SpecialEnterBoss) 不命中（目标在屏幕外），
            //   就滚列表（SpecialScrollList）继续找；归位已收紧为「不在主城分区」才命中，
            //   故此处不再被它 hijack（否则 15 行只有首屏 3 行能打，其余循环到超时）。
            "SpecialScrollList",
            "[JumpBack]PubReturnHome",
            "SpecialEntry"
        ]
    },
    "SpecialGameOverHold": {
        // ★#46★ GAMEOVER /「是否续关？」页守卫（只认页面锚点，绝不点任何按钮）★
        //   判据 = And(『GAMEOVER』横幅, 「是否续关？」) —— 与 #38 的 PubGameOverGiveUpFallback
        //   同一组页面锚点（common.json），但**没有 max_hit**：它是「这一帧是失败页」的
        //   永久前置捕获，绝不因点击次数用尽而消失（GiveUp/GiveUpFallback 的 max_hit=10 用尽
        //   后正是 SpecialBattleWait 顶上来的窗口，见 SpecialEntry.next 的 #46 注释）。
        //   动作 DoNothing：真正的『放弃』/『OK』点击仍由 [JumpBack]PubGameOver*（#38）读屏执行，
        //   绝不盲点、绝不点【续关】（星导石×50 是有限资源）。
        //   next 末位是恢复边 SpecialEntry（依赖事件层注入前缀/后缀，见 #18 规范形）。
        "recognition": {
            "type": "And",
            "param": { "all_of": ["PubGameOverTitle", "PubGameOverPrompt"] }
        },
        "action": { "type": "DoNothing", "param": {} },
        "post_delay": 1000,
        "next": [
            "[JumpBack]PubLoadingWait",
            "[JumpBack]PubDailyPopup",
            "[JumpBack]PubLevelUpContinue",
            "[JumpBack]PubNewCharTap",
            "[JumpBack]PubSkipStory",
            "[JumpBack]PubChallenge",
            "[JumpBack]SpecialBonusNo",
            "[JumpBack]SpecialRecruitOpen",
            "[JumpBack]PubReturnHome",
            "SpecialEntry"
        ]
    },
    "SpecialBattleWait": {
        // 战斗中：判据收敛到 common.json 的 PubBattleTime/PubBattleScore
        // （And：时间 \d+:\d+ + 分数 \d，见铁律 4）。
        // ★绝不改回裸「时间」「分数」：结算页「战斗分数」「最长滞空时间6秒」会误命中 → 空等死循环★
        // post_delay 与分派位置沿用本文件实测值（3000；必须排在分派链倒数第二，仅高于 SpecialWait）。
        "recognition": {
            "type": "And",
            "param": { "all_of": ["PubBattleTime", "PubBattleScore"] }
        },
        "action": { "type": "DoNothing", "param": {} },
        "post_delay": 3000,
        "next": [
            "[JumpBack]PubLoadingWait",
            "[JumpBack]PubDailyPopup",
            "[JumpBack]PubLevelUpContinue",
            "[JumpBack]PubNewCharTap",
            "[JumpBack]PubSkipStory",
            "[JumpBack]PubChallenge",
            "[JumpBack]SpecialBonusNo",
            "[JumpBack]SpecialRecruitOpen",
            "SpecialResultContinue",
            "[JumpBack]PubReturnHome",
            "SpecialEntry"
        ]
    },
    "SpecialWait": {
        // 兜底等待：认不出的画面只等待，绝不盲目点击
        "recognition": { "type": "DirectHit", "param": {} },
        "action": { "type": "DoNothing", "param": {} },
        "post_delay": 1500,
        "next": [
            "[JumpBack]PubLoadingWait",
            "[JumpBack]PubDailyPopup",
            "[JumpBack]PubLevelUpContinue",
            "[JumpBack]PubNewCharTap",
            "[JumpBack]PubSkipStory",
            "[JumpBack]PubChallenge",
            "[JumpBack]SpecialBonusNo",
            "[JumpBack]SpecialRecruitOpen",
            "[JumpBack]PubReturnHome",
            "SpecialEntry"
        ]
    }
