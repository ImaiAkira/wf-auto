            //   定义在 common.json（公共节点），此处以 [JumpBack] 引用。
            "[JumpBack]PubGameOverGiveUp",
            "[JumpBack]PubGameOverGiveUpFallback",
            "[JumpBack]PubGameOverConfirm",
            "[JumpBack]PubGameOverConfirmFallback",
            // 公共加载等待（common.json）：纯等待不点击；沿用原 SpecialLoadingWait 的位置。
