            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "wuchong_switch",
                "custom_action_param": {
                    "which": "auto",
                    "on": true,
                    "scene": "wuchong",
                    "on_unknown": "click"
                }
            }
        },
        "post_delay": 800,
        "next": [
            // ★#103-R1b★ 本步的候选 = **真后继**（进度由它提供）+ **末位**万能跳转（DirectHit，★必须末位★）。
            //   验证器（WuchongIn*）已退回本职：只被 SceneEnterWuchong 用做「到达确认」，不再进业务 next。
            "WuchongTeamContSet",
            "WuchongTeamChallenge",
            "WuchongRoomWait",
            "[JumpBack]SceneEnterWuchong"
        ],
        "on_error": ["WuchongEntry"],
        "timeout": 3000
    },
    "WuchongTeamContSet": {
        // 编队页/房间页「自动续战」：★确保【关】★（ruling ③：「自动续战的功能我不太想打开」）。
        // recognition = auto_switch_state（label=自动续战, state=on）→ **只在当前是开**时命中并去关；
        // 已是关（默认）则不动。「自动续战功能」确认框由动作先按『取消』处理（绝不打开功能）。
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "auto_switch_state",
                "custom_recognition_param": { "label": "自动续战", "state": "on", "ocr_entry": "OcrTask" }
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "wuchong_switch",
                "custom_action_param": {
                    "which": "cont",
                    "on": false,
                    "scene": "wuchong",
                    "on_unknown": "click"
                }
            }
        },
        "post_delay": 800,
        "next": [
            // ★#103-R1b★ 本步的候选 = **真后继**（进度由它提供）+ **末位**万能跳转（DirectHit，★必须末位★）。
            //   验证器（WuchongIn*）已退回本职：只被 SceneEnterWuchong 用做「到达确认」，不再进业务 next。
            "WuchongTeamChallenge",
            "WuchongRoomWait",
            "[JumpBack]SceneEnterWuchong"
        ],
        "on_error": ["WuchongEntry"],
        "timeout": 3000
    },
    "WuchongChallengeText": {
        // ★#110★ 编队页底部【挑战】的 OCR 门。判据真源 = scene/challenge.py::CHALLENGE_CLICK_PATTERNS：
        //   整串锚定 + 至多一个箭头（真机帧有 `挑战` / `挑战→` 两种渲染，8/17 帧带箭头）。
        "recognition": { "type": "OCR", "param": { "expected": ["^挑战(→)?$"], "roi": [150, 980, 600, 1180] } }
    },
    "WuchongStaleTeam": {
        // ★coop-fix2 P0★：多人模式下落在【本轮从未进过共斗房】的**单人编队页**（stale：上一轮
        //   单人留下的队伍页）→ 点「返回」离开、重走模式选择；绝不把它底部的「挑战」当成多人的。
        //   真机 07:45 leg_b 复盘：`--mode 多人`，可设备停在上轮单人的编队页，入口枢纽直接把
        //   「挑战」点了 → **又打一局单人**（`WuchongModeSolo` 已被选项关掉也不管用，因为整条
        //   流程根本没走到模式页）。判据用「本轮是否进过房」把 stale 编队页与「人齐编队页」分开。
        //   ★多人专用★：raw 默认关闭（__NONE__），由「游戏模式=多人游戏」开启；单人下编队页合法。
        //   ★#79★ **不许 ``max_hit``**（整任务共享计数，第 4 次起本节点静默失效 → 再也不会离开
        //     stale 编队页，直接卡死）。改用时间闩锁 ``latch: "stale_team"``（≤1 次/8s，永不失效）。
        "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"] } },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "wuchong_act",
                "custom_action_param": {
                    "what": ["^返回$"],
                    "roi": [0, 1180, 160, 1280],
                    "latch": "stale_team",
                    "expect": ["wuchong_mode", "wuchong_detail", "wuchong_lord_list", "main_city"]
                }
            }
        },
        "post_delay": 800,
        "next": [
            // ★#103-R1b★ 本步的候选 = **真后继**（进度由它提供）+ **末位**万能跳转（DirectHit，★必须末位★）。
            //   验证器（WuchongIn*）已退回本职：只被 SceneEnterWuchong 用做「到达确认」，不再进业务 next。
            "WuchongEntry",
            "[JumpBack]SceneEnterWuchong"
        ],
        "on_error": ["WuchongEntry"],
        "timeout": 3000
    },
    "WuchongTeamChallenge": {
        // 编队页 → 挑战（多人时是「人齐了」才可点）。★只点一次/局★（latch=battle_start）。
        // ★#78 节拍★：与共斗房同理 —— 真凶是 ``post_delay: 12000`` + ``timeout: 12000``
        //   （实测一次尝试 ≈20s），现压到 600 / 3000。动作仍是「点一次 + 立刻校验」。
        // ★#110★ 点击判据真源 = scene/challenge.py::CHALLENGE_CLICK_PATTERNS（`挑战` / `挑战→`
        //   两种渲染都认；整串锚定，绝不裸「挑战」）。
        "recognition": {
            "type": "And",
            "param": { "all_of": ["WuchongTeamState", "WuchongChallengeText"], "box_index": 1 }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "wuchong_act",
                "custom_action_param": {
                    "what": ["^挑战(→)?$"],
                    "roi": [150, 980, 600, 1180],
                    "latch": "battle_start",
                    // ★#77★ 同共斗房：loading 是过渡帧，不算「已开战」。
                    "expect": ["wuchong_battle"]
                }
            }
        },
        "post_delay": 600,
        "next": [
            // ★#103-R1b★ 本步的候选 = **真后继**（进度由它提供）+ **末位**万能跳转（DirectHit，★必须末位★）。
            //   验证器（WuchongIn*）已退回本职：只被 SceneEnterWuchong 用做「到达确认」，不再进业务 next。
            "WuchongBattle",
            "WuchongRoomWait",
            "[JumpBack]SceneEnterWuchong"
        ],
        "on_error": ["WuchongEntry"],
        "timeout": 3000
    },

    // ------------------------------------------------------------- 兜底
    "WuchongRoomLeave": {
        // ★#83★ 单人模式的「房间出口」：`游戏模式=单人` 时任何共斗房间都是**上一轮遗留**的
        //   （单人链路里根本不会进房），必须能自己走出去 —— 否则房间页没有任何可命中节点
        //   （`WuchongCoopChallenge` / `WuchongStaleTeam` 都是多人专用），只能干等
        //   ``WuchongGiveUp.room_wait_sec``(300s) 收工（真机 debug/wc_solo_10.log：90s+ 零点击）。
        //   ★raw 默认关★（默认模式是多人，多人下房间是合法的，绝不能自己退）；由「游戏模式=单人游戏」
        //   case 显式打开（与 WuchongCoopChallenge 的「多人专用」同构，方向相反）。
        //   动作：点房间左下【返回】（720 roi [0,1180,160,1280]），落到模式/详情/列表/主城都算成功；
        //   时间闩锁 ``latch: room_leave``（≤1 次/LATCH_RETRY_S，永不失效 —— ★不许 max_hit★）。
        "recognition": { "type": "OCR", "param": { "expected": ["__NONE__"] } },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "wuchong_act",
                "custom_action_param": {
                    "what": ["^返回$"],
                    "roi": [0, 1180, 160, 1280],
                    "latch": "room_leave",
                    "expect": ["wuchong_mode", "wuchong_detail", "wuchong_lord_list", "main_city"]
                }
            }
        },
        "post_delay": 600,
        "next": [
            // ★#103-R1b★ 本步的候选 = **真后继**（进度由它提供）+ **末位**万能跳转（DirectHit，★必须末位★）。
            //   验证器（WuchongIn*）已退回本职：只被 SceneEnterWuchong 用做「到达确认」，不再进业务 next。
            "WuchongEntry",
            "[JumpBack]SceneEnterWuchong"
        ],
        "on_error": ["WuchongEntry"],
        "timeout": 3000
    },

    "WuchongWait": {
        // 认不出的画面：只等待，绝不盲目点击。★最后的 DirectHit 万能兜底★（永远无限可用）。
        // ★绝不可加 max_hit★（用尽后会被永久跳过 → Tasker.Failed；见 abyss.json 的血泪教训）。
        "recognition": { "type": "DirectHit", "param": {} },
        "action": { "type": "DoNothing", "param": {} },
        "post_delay": 400,
        "next": ["WuchongEntry"]
    }
}
