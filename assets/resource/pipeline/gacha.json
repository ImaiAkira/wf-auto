{
    // 扭蛋（抽卡）—— 在当前打开的任意扭蛋池上抽 N 发十连，抽满即停。
    // 入口：GachaEntry
    //
    // ============ 真机实测流程（2026-10-19，127.0.0.1:16385，1080x1920）============
    //   池子页: [1次抽取] [10连抽取]  ← ★两个按钮同时在屏 = 池子页判据★
    //     -> 点 [10连抽取]
    //     -> 确认框（两种文案，同一颗按钮位置；区别只是「有没有十连券」，与池子类型无关）：
    //          有券: 是否使用XX十连券抽取XX？          -> [抽取扭蛋]
    //          没券: 现有对应特选扭蛋券数量不足 /
    //                是否消耗免费星导石 × N 进行购买？ -> [购买并抽取]（花免费星导石）
    //     -> 加载（黑屏转场 1~3s）
    //     -> 揭示页：右上角 [跳过] / [全部跳过]
    //     -> 汇总页: [继续 10连抽取] [前往扭蛋首页]  ← ★汇总页判据 = 屏上有「扭蛋首页」★
    //     -> 点 [继续 10连抽取] = 再抽一发（会再过一次确认框）
    //
    // ============ 坐标（720 空间；括号内为 1080 实测框）============
    //   10连抽取（池子页）   (571,1015)  ← 武器池框 (554,1499)-(881,1632)、角色池框 (728,1507)-(1039,1624) 两处都命中
    //   继续 10连抽取（汇总页）(360,1104)  ← 1080 框 (361,1584)-(720,1727)
    //   确认框右按钮          (522,826)   ← 1080 框 (560,1183)-(1007,1294)（抽取扭蛋 / 购买并抽取 同一位置）
    //   全部跳过              (673,184)   ← 1080 框 (940,224)-(1079,327)
    //   跳过                  (680,60)    ← 同时落在角色池「跳过」(673,74) 与武器系「跳过」(656,46) 框内
    //
    // ============ 计数与收工（★#26 承重★）============
    //   计数在 agent 侧（gacha_impl.GachaCountRecognition），口径 = **汇总页出现**：
    //   那是「这一发真的抽出去了」的正面证据（点确认框可能被用户取消，不算）。
    //   ★为什么不用 max_hit★：它是全任务共享的静默计数器，用光只会让节点从 next 里消失、
    //   不会结束任务 —— 旧实现正是栽在这里（GachaWait 是 DirectHit 兜底 → 永远空转）。
    //   抽满 N 发 -> GachaCount 命中 -> ★就地 StopTask★（不做任何导航）。
    //   ★为什么不点「前往扭蛋首页」★：那按钮回到的是扭蛋首页的**默认池**
    //   （真机：从装备池起步、收尾落在深渊限定）＝ 等于替用户换池。
    //   该池汇总页没有「继续」时（无法在原池连抽）也**就地收工**，理由写进进度行。
    //   连续 60s 没有新增一发 -> GachaStall 收工（ADR 0005：每个场景都要有界出口）。
    //
    // ============ 抛掉的旧设计（#26）============
    //   1) GachaPoolCheck（中间横幅池名 == 选项）：池名选项「装备扭蛋」写的是「装备」，
    //      实测横幅是「武器扭蛋」→ 永不命中，任务在这页抽不动。池名门已删除。
    //   2) GachaForbidden（深渊限定/竞速池 = StopTask）：OCR 没有 roi，
    //      会命中页面两侧的池子侧卡（实测侧卡会显示别的池名）→ 误杀正常抽卡。已删除。
    //   3) GachaContinue10.max_hit：见上，改用 agent 计数 + 显式出口。
    // ================================
    "GachaEntry": {
        "next": [
            // 公共换日弹窗（common.json）：最临时的全局打断，放最前。
            "[JumpBack]PubDailyPopup",
            // 公共账号页/标题页推进（common.json）。
            "[JumpBack]PubLoginContinue",
            "[JumpBack]PubTitleStart",
            // 公共加载等待（common.json）：纯等待不点击。
            "[JumpBack]PubLoadingWait",
            // ★★跳过提到最前（#30 v2）★★
            //   揭示页是循环里出现次数最多的一类帧（一发 2~3 帧）；旧顺序里它排在
            //   9~10 个候选之后，每帧都要先把确认框/继续/抽卡那些**全屏 OCR** 空试一遍。
            //   两颗跳过都是**带 ROI 的 OCR 门**（只认右上角那条），不会抢池子页/汇总页。
            "GachaSkipAll",
            "GachaSkip",
            // 确认框：有券 / 没券（花免费星导石）两条路合成一颗（同一颗按钮、一次 OCR）。
            "GachaConfirm",
            // ★计数出口★：数到 N 发就就地收工；没到 N 时返回未命中、放行给下面。
            "GachaCount",
            // ★无进展出口★：60s 没有新增一发就收工（不猜未知弹窗）。
            "GachaStall",
            // ★揭示页兜底★：★4 以上角色页**没有「跳过」按钮**（游戏停住等一次点击）。
            //   agent 闸门只在「不是池子页、也不是汇总页」时命中 → 点同一个记死的位置。
            //   放在这里（而不是最后）：池子页/汇总页都会先被上面的判据拦掉，不会误点。
            "GachaSkipFallback",
            // 公共新角色画面（common.json）：角色池抽到新角色时会挡在前面。
            //   ★放在兜底之后★：揭示页帧会被上面的跳过/兜底先接走，不必每帧跑这次识别。
            "[JumpBack]PubNewCharTap",
            // 「共计转换经验值 / 已将共计 N 个角色转换为经验值！」等弹窗 -> 关闭。
            //   同上：它很少出现，不该待在每帧的热路径上（一次全屏 OCR）。
            "GachaClosePopup",
            // 汇总页：继续连抽（下一发）。
            "GachaContinue10",
            // 池子页：抽下一发（第一发也走这里）。
            "GachaDraw10",
            // ★纯等待兜底★：加载/转场帧什么都不命中时挂住循环（不点击）。
            "GachaWait"
        ]
    },
    // ---------------------------------------------------------------------
    // 确认框：★两种文案、同一颗按钮★（区别只是有没有十连券，与池子类型无关）
    // ---------------------------------------------------------------------
    "GachaConfirm": {
        // ★两颗合成一颗（#30 v4 提速）★：两种文案是**同一颗按钮**（(522,826)），
        //   而 OCR 的 expected 支持列表（任一命中），所以一次 OCR 就能同时认
        //   「抽取扭蛋」（有券）与「购买并抽取」（没券，花免费星导石）。
        //   有券：「是否使用XX十连券抽取XX？」；没券：「现有对应特选扭蛋券数量不足 /
        //   是否消耗免费星导石 × N 进行购买？」。★绝不点「取消」★。
        //   ROI 只扫对话框按钮那一条（720 空间 y 740-900），面积约为全屏的 1/18。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["^抽取扭蛋$", "^购买并抽取$"], "roi": [300, 740, 420, 160] }
        },
        "action": {
            "type": "Click",
            "param": { "target": [522, 826] }
        },
        // 点完确认框马上进加载页（黑屏），这一档可以比「抽卡」短很多。
        "post_delay": 500,
        "next": ["GachaEntry"]
    },
    "GachaClosePopup": {
        // 「共计转换经验值」等结果弹窗 -> 点「关闭」（实测跑完多次 10 连后会出现）。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["^关闭$"] }
        },
        "action": { "type": "Click", "param": {} },
        "post_delay": 1000,
        "next": ["GachaEntry"]
    },
    // ---------------------------------------------------------------------
    // 计数出口（agent）：抽满 N 发 -> ★就地 StopTask（不做任何导航）★
    // ---------------------------------------------------------------------
    "GachaCount": {
        // 识别由 agent 的 gacha_count 提供；命中 = 已抽满 N 发（或该池无法在原池连抽）。
        // ★命中就 StopTask，不再点「前往扭蛋首页」★：那颗按钮回到的是扭蛋首页的**默认池**
        //   （真机：从装备池起步、收尾落在深渊限定）＝ 等于替用户换池。停在汇总页不动池子选择。
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "gacha_count",
                "custom_recognition_param": { "times": 1, "ocr_entry": "GachaOcrBottom" }
            }
        },
        "action": { "type": "StopTask", "param": {} },
        "next": []
    },
    "GachaStall": {
        // 有界出口（ADR 0005）：连续 no_progress_sec 秒没有新增一发 -> 收工并给原因。
        // agent 侧纯时钟判断，不跑 OCR。
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "gacha_stall",
                "custom_recognition_param": { "no_progress_sec": 60 }
            }
        },
        "action": { "type": "StopTask", "param": {} },
        "next": []
    },
    // ---------------------------------------------------------------------
    // 抽两发的两颗按钮
    // ---------------------------------------------------------------------
    "GachaOcrBottom": {
        // ★提速★：只 OCR 屏幕底部一条带（720 空间 y 940-1180），不扫全屏。
        //   池子页的「1次抽取 / 10连抽取」、汇总页的「继续 / 10连抽取 / 前往扭蛋首页」
        //   全在这条带里 —— agent 的两个识别（gacha_count / gacha_skip_gate）都改用它。
        //   expected [".*"] = 返回该 ROI 内所有文本框（同 common.json 的 OcrTask）。
        "recognition": {
            "type": "OCR",
            "param": { "expected": [".*"], "roi": [0, 940, 720, 240] }
        }
    },
    "GachaOnceBtn": {
        // 仅作 GachaDraw10 的子识别：池子页的「1次抽取」。
        // ★它同时也是「池子页 ≠ 汇总页」的判别器★ —— 汇总页只有「继续」。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["1次抽取"], "roi": [0, 940, 720, 240] }
        }
    },
    "GachaDraw10Btn": {
        // 仅作子识别：「10连抽取」（池子页与汇总页都会出现这四个字）。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["10连抽取"], "roi": [0, 940, 720, 240] }
        }
    },
    "GachaDraw10": {
        // 池子页抽 10 连：必须【同时】满足「1次抽取」和「10连抽取」。
        // ★点击目标不依赖 And 的 box_index★（实测它没有把点击位置切到按钮上），用固定坐标。
        "recognition": {
            "type": "And",
            "param": {
                "all_of": ["GachaOnceBtn", "GachaDraw10Btn"],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click",
            "param": { "target": [571, 1015] }
        },
        "post_delay": 900,
        "next": ["GachaEntry"]
    },
    "GachaContinueBtn": {
        // 仅作 GachaContinue10 的子识别：汇总页的「继续」（与「10连抽取」是同一颗按钮的两行字）。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["^继续$"], "roi": [0, 940, 720, 240] }
        }
    },
    "GachaContinue10": {
        // 汇总页：点「继续 10连抽取」直接连抽下一发。
        // ★不用 max_hit★ —— 计数与收工由 GachaCount/GachaStall 负责。
        "recognition": {
            "type": "And",
            "param": { "all_of": ["GachaContinueBtn", "GachaDraw10Btn"] }
        },
        "action": {
            "type": "Click",
            "param": { "target": [360, 1104] }
        },
        "post_delay": 1000,
        "next": ["GachaEntry"]
    },
    // ---------------------------------------------------------------------
    // 跳过：★只在真的看见按钮时才点★
    //   真机实测（1080x1920，720 空间）：
    //     角色池揭示页：「跳过」(673,74) + 「全部跳过」(673,184)
    //     武器系揭示页：只有「跳过」，位置更高（约 (656,46)）
    //   历史教训：早先版本用 DirectHit「一路点」，汇总页/池子页也照点，
    //   把顶部广告条/池子轮播点乱。现在两颗都带 OCR 门，落点仍写死。
    // ---------------------------------------------------------------------
    "GachaSkipAll": {
        // 「全部跳过」：在「跳过」下面那颗（角色池才有）。优先点它，一发能少点几次。
        // ROI 必须盖住它：720 空间实测框 (627,149)-(719,218)。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["全部跳过"], "roi": [580, 10, 140, 220] }
        },
        "action": {
            "type": "Click",
            "param": { "target": [673, 184] }
        },
        "post_delay": 500,
        "next": ["GachaEntry"]
    },
    "GachaSkip": {
        // 「跳过」：落点 (680,60) 同时落在角色池(673,74)与武器系(656,46)两颗按钮的框内。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["跳过"], "roi": [580, 10, 140, 220] }
        },
        "action": {
            "type": "Click",
            "param": { "target": [680, 60] }
        },
        "post_delay": 500,
        "next": ["GachaEntry"]
    },
    "GachaSkipFallback": {
        // ★4 以上角色的揭示页没有「跳过」按钮（真机 2026-10-20：哈奥 ★4 页无按钮，停住等点击）。
        // 识别由 agent 的 gacha_skip_gate 提供：**不在池子页、也不在汇总页** 时才命中。
        // 落点仍是那个记死的「全部跳过」位置。
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "gacha_skip_gate",
                "custom_recognition_param": { "ocr_entry": "GachaOcrBottom" }
            }
        },
        "action": {
            "type": "Click",
            "param": { "target": [673, 184] }
        },
        "post_delay": 500,
        "next": ["GachaEntry"]
    },
    "GachaWait": {
        // ★纯等待兜底（不点击）★：加载/转场帧什么都不命中时，靠它把循环挂住。
        //   没有它的话，一帧全 miss 就会让任务直接 FAILED（本轮真机 34.5s 失败即此）。
        //   它与历史上的 GachaWait 相同，但**不再是唯一的出口** —— 计数与收工由
        //   GachaCount/GachaStall 负责。
        "recognition": { "type": "DirectHit", "param": {} },
        "action": { "type": "DoNothing", "param": {} },
        "post_delay": 800,
        "next": ["GachaEntry"]
    }
}
