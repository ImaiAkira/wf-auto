{
    // 外传 Side Story —— 「自动过外传」（剧情 + 打关 / 只打当前，已合并为一个任务）
    // 入口：SideStoryEntry（SideClearEntry 保留为【等价别名入口】，兼容旧配置）
    //
    // ===================== 识别驱动导航（新增） =====================
    //   主城（中央【关卡】大按钮）→ 关卡页（右侧【外传故事】横幅）→ 外传故事列表
    //     · SideNavStage     ：主城点【关卡】   （坐标来自真机 16448 step0_16448.png）
    //     · SideNavStoryTab  ：关卡页点【外传故事】（坐标来自真机 16448 step1.png）
    //   两个节点都是「看到才点」：已在目标页 / 已在某个外传里时都不命中，
    //   所以手动进外传、或在任意外传内直接跑任务，行为与以前完全一致（纯增量）。
    //   ★判据精确★：见各节点注释（ROI + 两端锚定，绝不做宽匹配）。
    //
    // ===================== 选项「外传是否刷所有的」 =====================
    //   本文件不定义 interface.json；由上层（编排）把该选项挂到任务「自动过外传」上。
    //   · 是（默认）= 现状：清完「外传故事列表」里所有未通关外传。
    //   · 否 = 只打【当前已打开】的那一个外传，禁止在列表页点第一张卡：
    //       - SideClearPickTab   → recognition 置 OCR expected ["__NONE__"]（关「未通关」tab）
    //       - SideClearEnterCard → recognition 置 OCR expected ["__NONE__"]（关「点第一张卡」）
    //       - SideClearListGate  → action 置 StopTask（打完当前外传回到列表即收工；
    //                               也兜住「否」却在列表页起跑的情况，绝不空转）
    //     ★刻意【不关】SideClearDone（空列表收工）与 SidePageDoneStop（防空转）★。
    //     ★导航节点 SideNavStage/SideNavStoryTab 不关★：它们只是把游戏带到列表；
    //       「否」下到达列表后由 SideClearListGate 收工，不会点卡，语义仍安全。
    //
    // 【重要设计原则：本文件必须自包含，不要复用 auto_push.json 的节点！】
    //   踩过的坑：曾经直接引用 auto_push 的节点，但那些节点的 next 都写着 ["AutoPush"]，
    //   于是外传任务执行到任一个复用节点后，管线就【跳进 AutoPush 的分派器】，
    //   变成主线任务在跑 —— 表现为 PushStageFixed 反复点死坐标 (351,463) 空转卡死。
    //   所以这里每个节点都用 Side* 前缀自带一份，next 一律指回 SideStoryEntry。
    //
    // ================= 实测流程（16448，1080x1920 原始坐标）=================
    //   外传列表页（STORY 标签 + NEW / COMPLETE!! 徽标）
    //     ↓ 点 NEW 徽标所在那一行（SideStoryEnter）
    //   弹窗「是否开始阅读故事?」 否 [271,1212]  是 [760,1210]  -> SideReadYes 点「是」
    //     ↓ 加载 -> 剧情（跳过> [919,46]）-> 跳过确认（跳过 原始 (783,1303)）
    //     ↓ 关卡详情页（有「战斗」/「推荐编成」）-> SideFight 点「战斗」
    //     ↓ 编队页 -> SideChallenge 点「挑战」-> 战斗 -> 结算 -> 回列表 -> 下一关
    //
    // ================= 其它踩过的坑 =================
    //  1) 进入关卡的锚点必须用 NEW 徽标，不能用 STORY 标签（每行都有 STORY，
    //     OCR 的 best 按分数选会落在已通关的行上）。
    //  2) 绝不做盲目兜底点击：认不出的画面只等待（SideWait），不满屏乱点。
    //  3) 不做「自动关菜单」：实测点菜单里的返回会把页面一起退走，
    //     且判据「成长基金」在菜单外也存在会误触发。
    //  4) 全部节点不设 max_hit（累计计数用满后节点会被静默跳过）。
    // =================================================
    "SideStoryEntry": {
        "next": [
            // 公共换日弹窗（common.json）：最临时的全局打断，放最前。
            "[JumpBack]PubDailyPopup",
            "SideStallRecover",
            // 公共账号页/标题页推进（common.json）：原地替换原 SideLoginContinue/SideTitleStart。
            // ★等价性★：二者原 next=["SideStoryEntry"]；两个入口分派表逐项一致，
            //   [JumpBack] 回各自调用入口，行为等价。
            "[JumpBack]PubLoginContinue",
            "[JumpBack]PubTitleStart",
            // 公共加载等待（common.json）：纯等待不点击；沿用原 SideLoadingWait 的位置。
            "[JumpBack]PubLoadingWait",
            "SideResultContinue",
            "SideResultFallback",
            // 公共升级结算（common.json）：原地替换原 SideLevelUpContinue。
            // ★等价性★：原 next=["SideStoryEntry"]（两个入口分派表一致）→ [JumpBack] 等价。
            "[JumpBack]PubLevelUpContinue",
            "SideItemContinue",
            "SideRewardClose",
            "SideNewCharTap",
            "SideReadYes",
            "SideSkipConfirm",
            // 公共跳过剧情（common.json）：原地替换原 SideSkipStory。
            // ★等价性★：原 next=["SideStoryEntry"]（两个入口分派表完全一致）→ [JumpBack] 等价。
            "[JumpBack]PubSkipStory",
            "SideLeaveRoom",
            // ★「体力不足 → 星岛石恢复」★（scene/stamina.py 是真源）：外传关卡「挑战」消耗体力，
            //   不足时游戏弹回复体力弹窗 —— 共享节点「先点星导石行、再点确认框 OK」（只用星岛石）。
            //   两个入口分派表（SideStoryEntry / SideClearEntry）逐项一致，故两处都插。
            // ★#102 P0-1★ 模板通道排在 OCR 版**之前**（模板优先、OCR 兜底）：两者都是
            //   「And(弹窗正文, 星导石行) → 点该行框中心」，只差行判据（图标模板 vs 行名 OCR）。
            //   真源：scene/templates.py（STONE_TPL_WIRED_HUBS / STONE_TPL_REF）。
            "[JumpBack]PubStaminaUseStoneTpl",
            "[JumpBack]PubStaminaUseStone",
            "[JumpBack]PubStaminaConfirmOk",
            "[JumpBack]PubStaminaDoneOk",
            // 公共「挑战」（common.json）：原地替换原 SideChallenge。
            // ★等价性★：原 next=["SideStoryEntry"]（两个入口分派表一致）→ [JumpBack] 等价。
            "[JumpBack]PubChallenge",
            "SideBattleWait",
            "SideClearDone",
            "SideClearPickTab",
            "SideClearEnterCard",
            "SideClearListGate",
            "SideNextSpecial",
            "SideNextStory",
            "SideNextBattle",
            "SideFight",
            "SideEnter",
            "SidePageDoneStop",
            "SidePageDone",
            "SideBack",
            // 识别驱动导航（本文件头有完整说明）：主城 → 关卡页 → 外传故事列表。
            // 放在最后（SideWait 之前）：只有其它节点全不命中（=不在任何外传流程里、
            // 手动停在主城/关卡页）时才轮到它；已在目标页则不命中。
            "SideNavStage",
            "SideNavStoryTab",
            "SideWait"
        ]
    },
    "SideClearEntry": {
        // 【外传全清】入口：从「外传故事列表」开始，点「未通关」→ 逐个进外传打完 → 返回列表 → 直到列表空。
        // 与 SideStoryEntry 共用同一套 Side*/SideClear* 节点（分派列表保持一致），
        // 区别只在任务起点：本任务起点是外传故事列表页。
        "next": [
            // 公共换日弹窗（common.json）：最临时的全局打断，放最前。
            "[JumpBack]PubDailyPopup",
            "SideStallRecover",
            // 公共账号页/标题页推进（common.json）：原地替换原 SideLoginContinue/SideTitleStart。
            // ★等价性★：二者原 next=["SideStoryEntry"]；两个入口分派表逐项一致，
            //   [JumpBack] 回各自调用入口，行为等价。
            "[JumpBack]PubLoginContinue",
            "[JumpBack]PubTitleStart",
            // 公共加载等待（common.json）：纯等待不点击；沿用原 SideLoadingWait 的位置。
            "[JumpBack]PubLoadingWait",
            "SideResultContinue",
            "SideResultFallback",
            // 公共升级结算（common.json）：原地替换原 SideLevelUpContinue。
            // ★等价性★：原 next=["SideStoryEntry"]（两个入口分派表一致）→ [JumpBack] 等价。
            "[JumpBack]PubLevelUpContinue",
            "SideItemContinue",
            "SideRewardClose",
            "SideNewCharTap",
            "SideReadYes",
            "SideSkipConfirm",
            // 公共跳过剧情（common.json）：原地替换原 SideSkipStory。
            // ★等价性★：原 next=["SideStoryEntry"]（两个入口分派表完全一致）→ [JumpBack] 等价。
            "[JumpBack]PubSkipStory",
            "SideLeaveRoom",
            // ★「体力不足 → 星岛石恢复」★（scene/stamina.py 是真源）：外传关卡「挑战」消耗体力，
            //   不足时游戏弹回复体力弹窗 —— 共享节点「先点星导石行、再点确认框 OK」（只用星岛石）。
            //   两个入口分派表（SideStoryEntry / SideClearEntry）逐项一致，故两处都插。
            // ★#102 P0-1★ 模板通道排在 OCR 版**之前**（模板优先、OCR 兜底）：两者都是
            //   「And(弹窗正文, 星导石行) → 点该行框中心」，只差行判据（图标模板 vs 行名 OCR）。
            //   真源：scene/templates.py（STONE_TPL_WIRED_HUBS / STONE_TPL_REF）。
            "[JumpBack]PubStaminaUseStoneTpl",
            "[JumpBack]PubStaminaUseStone",
            "[JumpBack]PubStaminaConfirmOk",
            "[JumpBack]PubStaminaDoneOk",
            // 公共「挑战」（common.json）：原地替换原 SideChallenge。
            // ★等价性★：原 next=["SideStoryEntry"]（两个入口分派表一致）→ [JumpBack] 等价。
            "[JumpBack]PubChallenge",
            "SideBattleWait",
            "SideClearDone",
            "SideClearPickTab",
            "SideClearEnterCard",
            "SideClearListGate",
            "SideNextSpecial",
            "SideNextStory",
            "SideNextBattle",
            "SideFight",
            "SideEnter",
            "SidePageDoneStop",
            "SidePageDone",
            "SideBack",
            // 识别驱动导航（本文件头有完整说明）：主城 → 关卡页 → 外传故事列表。
            // SideClearEntry 与 SideStoryEntry 的分派表保持【逐项一致】（别名入口）。
            "SideNavStage",
            "SideNavStoryTab",
            "SideWait"
        ]
    },
    "SideStallRecover": {
        // 【卡死自恢复·需求 #3】画面连续 N 秒无变化 → 判定卡死 → 结束任务（不空转）。
        // 阈值复用 interface「无响应重开阈值」（默认 180s），不新造一套。
        //
        // ★为什么放在分派表【很靠前】★（紧随公共换日弹窗 PubDailyPopup）
        //   MaaFramework 逐项识别、先命中先执行。放在很靠前可保证【每一轮】都评估，
        //   连「某个节点反复命中但画面纹丝不动」的死循环也能兜住；放在后面时，
        //   只要前面某个节点一直命中，本节点就永远轮不到。
        //   注意：公共换日弹窗故意排在它【前面】（最临时的全局打断），所以若弹窗
        //   被点了却因输入冻结不消失，弹窗会持续命中、本节点轮不到 —— 见 common.json 的说明。
        //   正常流程画面在动 → diff 超阈值 → 不命中，对流程零副作用。
        //
        // ★误报风险★：识别/等待节点（SideWait/PubLoadingWait/SideBattleWait）本身
        //   不改变画面。若某个加载页/等待页真的静止超过阈值（网络卡死、游戏 hang），
        //   本节点会命中并收工 —— 这恰恰是我们要的「卡死兜底」；只有「画面真的静止
        //   但流程其实在正常等待超 180s」才会误伤，实测正常流程不存在这种静止。
        //
        // ★恢复动作为什么选 StopTask（而不是 restart_game）★
        //   本文件现已自带「主城 → 关卡页 → 外传故事列表」的导航（SideNavStage/
        //   SideNavStoryTab）。但本次改动遵循【纯增量】，不改卡死恢复语义：
        //   仍用 StopTask 干净收工（绝不空转），由用户/上层重新进入外传；
        //   改成 restart_game（拉回主城再自动导航）属后续独立改动。
        //   （特殊副本那边 SpecialStallRecover 一直用 restart_game。）
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "stall_recover",
                "custom_recognition_param": { "threshold_sec": 180 }
            }
        },
        "action": { "type": "StopTask", "param": {} },
        "post_delay": 1000,
        "next": ["SideStoryEntry"]
    },
    "SideClearDone": {
        // 【外传全清·终止判据】「未通关」列表已空时结束任务。
        // ★真实文案已实测（clear_all 跑空列表时抓屏 side_empty.png，720 (357,806)）：
        //   「未找到符合的外传故事」★
        // 命中即 StopTask 收工 —— 这就是「未通关列表也没有可进的卡片」的收工条件。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["未找到符合的外传故事"] }
        },
        "action": { "type": "StopTask", "param": {} },
        "next": ["SideStoryEntry"]
    },
    "SideClearPickTab": {
        // 【外传全清】外传故事列表页：点「未通关」筛选 tab（实测 u1 (119,405)）。
        // max_hit:1 —— 点一次即可，否则每轮都命中会饿死后面「进卡片」的节点。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["未通关"], "roi": [0, 375, 240, 70] }
        },
        "action": { "type": "Click", "param": { "target": [119, 405] } },
        "max_hit": 1,
        "post_delay": 1500,
        "next": ["SideStoryEntry"]
    },
    "SideClearListTitle": {
        // 仅作 SideClearEnterCard 的子识别：外传故事列表页标题。
        // 用 And 把「进卡片」限制在列表页内，避免在别的页面误命中卡片标记。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["外传故事列表"] }
        }
    },
    "SideClearCardMark": {
        // 仅作 SideClearEnterCard 的子识别：卡片上的「角色加入/装备获得」标记。
        // ROI 限定第一张卡带（实测 u1 第一张在 720 y≈566，第二张 y≈711 已被排除）。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["角色加入/装备获得"], "roi": [0, 430, 720, 170] }
        }
    },
    "SideClearEnterCard": {
        // 【外传全清】外传故事列表页：点【第一张卡】进入该外传的关卡列表。
        // And(列表标题 + 第一张卡标记) 双重限定；box_index=1 取卡片标记框（仅用于定位，点击用固定点）。
        // 命中才点第一张卡固定位置 (360,480)；列表为空没有标记 → 不会乱点。
        // ★P0（本票）★：上面两行已【过时】——动作已从死坐标 (360,480) 改为 target:true
        //   （点识别框中心）。死坐标不随识别框走：卡带一抖就可能落到卡左下
        //   （详情页左下 = 【推荐编成】→ 弹 Party 选择层、改掉用户队伍配置）。
        //   标记框在卡内 → 点它即开卡；列表为空没有标记 → 不会乱点（语义不变）。
        "recognition": {
            "type": "And",
            "param": {
                "all_of": ["SideClearListTitle", "SideClearCardMark"],
                "box_index": 1
            }
        },
        "action": { "type": "Click", "param": { "target": true } },
        "post_delay": 2500,
        "next": ["SideStoryEntry"]
    },
    "SideClearListGate": {
        // 【外传全清·返回保护】外传故事列表页：只等待，绝不按返回键。
        // 排在 SideBack 之前「吃掉」列表页的分派，防止 SideBack 的 ^STORY$ 在列表页被
        // 误命中 → 连按返回键把游戏退回标题页（规格 B3 指出的隐患）。
        // 实测列表页没有 STORY，本节点是双保险；列表为空时任务停在这里等待。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["外传故事列表"] }
        },
        "action": { "type": "DoNothing", "param": {} },
        "post_delay": 1500,
        "next": ["SideStoryEntry"]
    },
    // =====================================================================
    // 【账本驱动的选关】—— 外传关卡列表分派只对「账本说下一个该做」的那一行出手
    //
    // next_stage 的参数：
    //   · row_type="特殊战斗" / "STORY" / "战斗"  —— 只挑该类型的行，实现
    //     「长按剧情行 / 普通点击剧情行 / 普通点击战斗行」的区分；
    //   · require_badge=true —— 只在外传关卡列表页命中（页面有 NEW/COMPLETE 徽标）；
    //   · 默认 check_badge=true —— 画面上已标 COMPLETE!! 的行直接被跳过
    //     （用户手动通透过、账本里没有的旧关卡也不会再碰）。
    //
    // 选中后 next_stage 会把 (scope, 关卡名) 写进 pending，做完由 mark_done 记账；
    // 已记账的关卡在后续任何一轮 next_stage 里都不会再被返回 —— 这就是
    // 「已完成的绝不再碰 / 不重复打同一关」的直接保证。
    // =====================================================================
    "SideNextSpecial": {
        // 剧情/特殊行（行类型标签「特殊战斗」）：普通点击无效，必须【长按标题】。
        // 实测 720 (259,733)，约 800ms。target:true = 用 next_stage 返回的标题框。
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "next_stage",
                "custom_recognition_param": {
                    "scene": "side_story",
                    "row_type": "特殊战斗",
                    "require_badge": true
                }
            }
        },
        "action": {
            "type": "LongPress",
            "param": { "target": true, "duration": 800 }
        },
        "post_delay": 2500,
        "next": ["SideStoryEntry"]
    },
    "SideNextStory": {
        // 纯剧情行（只有 STORY 标记）：普通点击标题进入。
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "next_stage",
                "custom_recognition_param": {
                    "scene": "side_story",
                    "row_type": "STORY",
                    "require_badge": true
                }
            }
        },
        "action": { "type": "Click", "param": { "target": true } },
        "post_delay": 2500,
        "next": ["SideStoryEntry"]
    },
    "SideNextBattle": {
        // 战斗行（行类型标签「战斗」）：普通点击标题进入。
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "next_stage",
                "custom_recognition_param": {
                    "scene": "side_story",
                    "row_type": "战斗",
                    "require_badge": true
                }
            }
        },
        "action": { "type": "Click", "param": { "target": true } },
        "post_delay": 2500,
        "next": ["SideStoryEntry"]
    },
    "SideMarkDonePending": {
        // 剧情走完（新角色画面点掉）后，把 next_stage 选中的那一关记进账本。
        // 只经 SideNewCharTap.next 到达，不在主分派表里，不会空跑。
        "recognition": { "type": "DirectHit", "param": {} },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "mark_done",
                "custom_action_param": { "scene": "side_story" }
            }
        },
        "next": ["SideStoryEntry"]
    },
    "SideStoryNodeLabel": {
        // 仅作 SideStoryNode 的子识别：关卡列表【当前 NEW 行】的行类型标签「特殊战斗」。
        // ★判据依据（16448 实测 ax6 / 手动长按复现）★：
        //   · 普通战斗行的行类型标签是精确的「战斗」（秘宝之力行，720 (103,1084)）；
        //   · 特殊/锁档行的行类型标签是「特殊战斗」（前往圣地行，720 (104,794)）。
        //   用 ^特殊战斗$ 精确匹配，天然排除普通战斗行（^战斗$ 不会命中「特殊战斗」，
        //   反之 ^特殊战斗$ 也不会命中「战斗」）。d4.png（领主战纯战斗行：NEW + 首次报酬 + 战斗）
        //   没有「特殊战斗」→ 本节点不命中（负样本回归点）。
        // ROI 限定在【关卡列表第 1 行行内】(y 600~830)：实测关卡列表总是把当前 NEW 行
        //   自动滚到最上方（ax6/fight_before/stage_list2/new_detail 均 NEW y=685、
        //   特殊战斗 y=794；st_after2 的 NEW 行 y=685 也是 STORY 行）。
        //   → 用「同一行带」把 NEW 徽标和「特殊战斗」标签关联起来，避免
        //     「NEW 在 STORY 行、特殊战斗 在别处 COMPLETE 行」时误命中
        //     （st_after2：NEW 行 y685 是 STORY，特殊战斗 y1082 属 COMPLETE 的 前往圣地，
        //      若不加 ROI 会错误地去长按已通关的行）。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["^特殊战斗$"], "roi": [0, 600, 720, 230] }
        }
    },
    "SideStoryNodeNew": {
        // 仅作 SideStoryNode 的子识别：关卡列表第 1 行的 NEW 徽标（未通关标记）。
        // ★必须与 SideStoryNodeLabel 用【同一个行带 ROI】，实现行内关联★。
        // 实测 ax6 NEW 徽标 720 (41,685)、st_after2 (40,685)，都在本 ROI 内。
        // （SideNewCharTap 用的是大 NEW 徽标 roi [0,800,400,340]，本 ROI 在 y600~830，
