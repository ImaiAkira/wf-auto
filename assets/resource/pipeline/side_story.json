        // ★正则用 ^NEW 而不是 ^NEW$★：实测 HERO BEGINNING 外传的 NEW 徽标紧贴像素立绘，
        //   OCR 会多读出一个尾巴「NEWT」(clr_SideClearEntry_STALL.png 720 (49,690))，
        //   ^NEW$ 因此漏判导致整页没有任何节点命中 → stall。^NEW 前缀匹配可容错。
        "recognition": {
            "type": "OCR",
            "param": { "expected": ["^NEW"], "roi": [0, 600, 720, 230] }
        }
    },
    "SideStoryNode": {
        // 【进剧情/特殊节点】关卡列表里【同一行】同时是 NEW + 特殊战斗 的那一行：
        //   普通点击对它无效，必须【长按】该行标题文字才能进入（实测约 800ms）。
        //   进入后要么是剧情页（走 SideSkipStory/SideSkipConfirm/SideNewCharTap），
        //   要么是关卡详情页（走 SideChallenge），两条路都已在 next 分派表里接好。
        //
        // 【为什么必须有这个节点】旧的 SideFight = And(首次报酬, 战斗) 会在关卡列表上
        //   误命中：列表里「未通关行有首次报酬」+「另一行的行类型标签是战斗」跨行凑齐，
        //   于是 SideFight 去点那一行【已通关】的「战斗」标签 → 什么都不发生 →
        //   进度纹丝不动（这就是外传清不空的根因）。
        //   本节点排在 SideFight / SideEnter 之前，先把 NEW+特殊战斗 这一行打开。
        //
        // 【与战斗行的区分】战斗行特征 = 首次报酬 + 战斗（SideFight）；剧情/特殊行特征
        //   = NEW + 特殊战斗 且该行【没有】「战斗」标签。这里用 ^特殊战斗$ 与行内 ROI
        //   双重限定，保证 d4.png 这类纯战斗行仍归 SideFight，不被本节点抢走。
        //
        // 【长按目标】box_index=0 取「特殊战斗」标签框作锚点，target_offset 偏移到该行
        //   标题文字中心：实测 720 标签(104,794) → 标题(259,739)，偏移 (+155,-55)。
        // ★本票审计★：本节点是【外传关卡列表的行锚点】——「该行卡片」没有 OCR 框，
        //   只有行内小标签（特殊战斗）有框，故「锚点框 + 偏移到行标题中心」是必要的。
        //   安全性：偏移【向左上】（-x,+y 反向：向右 +155、向上 -55）= 行标题中心（卡片中上部），
        //   与详情页左下角的【推荐编成】无任何几何关系（本页根本没有该控件）→ 安全。
        //   偏移幅值有界（|dx|≤300、|dy|≤120），守卫 tools/test_click_center.py 钉死。
        "recognition": {
            "type": "And",
            "param": {
                "all_of": ["SideStoryNodeLabel", "SideStoryNodeNew"],
                "box_index": 0
            }
        },
        "action": {
            "type": "LongPress",
            "param": { "target": true, "target_offset": [155, -55, 0, 0], "duration": 800 }
