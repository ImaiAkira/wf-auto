        // ★安全：只点屏幕「返回」(720 53,1259)，绝不 KeyEvent 4★。
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "list_all_done",
                "custom_recognition_param": { "ocr_entry": "OcrTask" }
            }
        },
        "action": { "type": "Click", "param": { "target": [53, 1259] } },
        "post_delay": 3000,
        "next": ["SideStoryEntry"]
    },
    "SideBack": {
