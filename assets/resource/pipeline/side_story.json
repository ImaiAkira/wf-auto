        // ★安全：StopTask 收工，不点击、不按返回键★。
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "page_done_repeat",
                "custom_recognition_param": { "ocr_entry": "OcrTask", "threshold": 3 }
            }
        },
        "action": { "type": "StopTask", "param": {} },
        "post_delay": 1000,
        "next": ["SideStoryEntry"]
    },
    "SidePageDone": {
        // 【本页全清·出口·需求 #1】外传【关卡列表页】已全部 COMPLETE!!
        //（没有任何 NEW / 未完成行）→ 判定这本外传打完了 → 点左下「返回」退回
        //「未通关」列表清下一个；若列表也空了，由 SideClearDone 收工。
        //
        // 由 list_all_done 自定义识别判定：画面有 ≥1 个 COMPLETE!! 徽标、
        // 且【没有任何 NEW 徽标】、且能解析出关卡行。
        //
        // 排在所有选关节点（SideNext*/SideStoryNode/SideEnter）之后、SideBack/SideWait
        // 之前：真有关卡要做时先被前面节点接走，一个都选不出来时才走本出口。
        //
        // ★为什么必须有它★：旧的关卡列表出口只有 SideBack（判据 ^STORY$），
